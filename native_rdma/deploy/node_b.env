# --- Node B (example) -------------------------------------------------
SELF_IP=<NODE_B_IP>
PEER_IP=<NODE_A_IP>
RDMA_DEV=<RDMA_DEV>
GID_IDX=<GID_IDX>
DATA_PORT=<DATA_PORT>

UDS_PATH=/tmp/native_rdma-dp.sock
METRICS_SHM=/tmp/native_rdma-metrics.shm

CTRL_PORT=<CTRL_PORT>
WEB_PORT=<WEB_PORT>

DRAM_CAP_BYTES=34359738368       # 32 GB (smaller on node B)
NVME_PATH=/dev/shm/native_rdma_warm
NVME_CAP_BYTES=1073741824000
# IMPORTANT: node B's /home is nearly full; use a dedicated partition here.
HDD_PATH=<NODE_B_COLD_PATH>
HDD_CAP_BYTES=5497558138880      # 5 TB
