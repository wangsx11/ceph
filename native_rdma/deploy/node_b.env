# --- Node B (xfusion4) -----------------------------------------------
# RDMA 数据面与控制面配置（演示用，内存占用低；/home 已 96%，冷层放 /tmp）
SELF_IP=192.168.0.214
PEER_IP=192.168.0.218
RDMA_DEV=mlx5_0
GID_IDX=3
DATA_PORT=18515

UDS_PATH=/tmp/native_rdma-dp.sock
METRICS_SHM=/tmp/native_rdma-metrics.shm

CTRL_PORT=7001
WEB_PORT=5000

# Demo sizing (smaller than node A)
# Hot tier: DRAM 1 GB
DRAM_CAP_BYTES=1073741824
# Warm tier: tmpfs-backed "NVMe", 4 GB
NVME_PATH=/dev/shm/native_rdma_warm
NVME_CAP_BYTES=4294967296
# Cold tier: /home is 96% full on xfusion4, use /tmp (root fs has 366G free), 10 GB
HDD_PATH=/tmp/nr_cold
HDD_CAP_BYTES=10737418240

# NUMA binding: HCA on node1
NUMA_NODE=1

# --- Tier migrator timing (for §6 demo) --------------------------------
# DRAM 对象 idle 4s 才判定"温"下沉到 NVMe
#   ← 必须高于 hot_keys 两次访问间隔（20 轮 × 32 key × 0.1s = ~3.2s/key），
#     否则连 hot_keys 也会被下沉，演示里看到 DRAM=0 就是这个原因。
# NVMe 对象 idle 2s 判定"冷"下沉到 HDD（低于 DRAM 阈值，保持层级语义）。
# migrator 每 300ms 扫描一次（单轮无上限，见 main.cpp mig_thr）。
DRAM_DEMOTE_IDLE_MS=4000
NVME_DEMOTE_IDLE_MS=2000
MIGRATE_INTERVAL_MS=300
