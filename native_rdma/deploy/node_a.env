# --- Node A (xfusion3) -----------------------------------------------
# RDMA 数据面与控制面配置（演示用，各层容量已调小以节省内存）
SELF_IP=192.168.0.218
PEER_IP=192.168.0.214
RDMA_DEV=mlx5_0
GID_IDX=3
DATA_PORT=18515

UDS_PATH=/tmp/native_rdma-dp.sock
METRICS_SHM=/tmp/native_rdma-metrics.shm

# Control plane
CTRL_PORT=7001
WEB_PORT=5000

# Data directories (demo sizing, keep small)
# Hot tier: DRAM 2 GB
DRAM_CAP_BYTES=2147483648
# Warm tier: tmpfs-backed "NVMe", 8 GB
NVME_PATH=/dev/shm/native_rdma_warm
NVME_CAP_BYTES=8589934592
# Cold tier: real disk under /home (xfusion3 /home has 7T free), 20 GB
HDD_PATH=/home/wangshouxin/nr_cold
HDD_CAP_BYTES=21474836480

# NUMA binding: HCA on node0
NUMA_NODE=0

# --- Tier migrator timing (for §6 demo) --------------------------------
# DRAM 对象 idle 500ms 即可被 migrator 判定"温"，下沉到 NVMe
# NVMe 对象 idle 1.5s 即可被判定"冷"，下沉到 HDD
# migrator 每 300ms 扫描一次（上限 unlimited，见 main.cpp mig_thr）
DRAM_DEMOTE_IDLE_MS=500
NVME_DEMOTE_IDLE_MS=1500
MIGRATE_INTERVAL_MS=300
