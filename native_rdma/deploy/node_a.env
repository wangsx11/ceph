# --- Node A (xfusion3) -----------------------------------------------
# RDMA 数据面与控制面配置（演示用，各层容量已调小以节省内存）
SELF_IP=192.168.0.218
PEER_IP=192.168.0.214
RDMA_DEV=mlx5_0
GID_IDX=3
DATA_PORT=18515

UDS_PATH=/tmp/native_rdma-dp.sock
METRICS_SHM=/tmp/native_rdma-metrics.shm

# Control plane
CTRL_PORT=7001
WEB_PORT=5000

# Data directories (demo sizing, keep small)
# Hot tier: DRAM 2 GB
DRAM_CAP_BYTES=2147483648
# Warm tier: tmpfs-backed "NVMe", 8 GB
NVME_PATH=/dev/shm/native_rdma_warm
NVME_CAP_BYTES=8589934592
# Cold tier: real disk under /home (xfusion3 /home has 7T free), 20 GB
HDD_PATH=/home/wangshouxin/nr_cold
HDD_CAP_BYTES=21474836480

# NUMA binding: HCA on node0
NUMA_NODE=0

# --- Tier migrator timing (for §6 demo, heat-score mode v2) ------------
# 剧本分类：100 对象
#   · HOT=30: step3 里被高频访问 (>=5 次) → heat_score 累计>1.5 → 留 DRAM
#   · WARM=30: step3 里被轻访问 (1 次)  → heat_score≈1.0，衰减到 <0.40 后降 NVMe；
#                read_cnt>=1 → W2 规则：永留 NVMe（不再降 HDD）
#   · COLD=40: step3 中完全不访问 → heat_score=0，grace 过后立即降 NVMe；
#                read_cnt==0 → 继续降 HDD
#
# 参数说明：
#   DEMOTE_HOT_SCORE: DRAM→NVMe 阈值，score<0.40 降级
#   DEMOTE_WARM_SCORE: NVMe→HDD 阈值（配合 read_cnt==0），保留较低值
#   TIME_DECAY_ALPHA: 每秒 score 衰减 exp(-0.3) ≈ 0.74 倍
#   HEAT_SCORE_INIT: 每次访问增加的 score 量
#   SCORE_GRACE_MS: 对象出生后保护期，避免 step3 未开始就被判冷
#   MIGRATE_INTERVAL_MS: migrator 扫描周期 (300ms 保证 demo 反应快)
#   MIGRATE_BATCH_LIMIT: 每轮后台最多迁移对象数，避免前端看到整批瞬移
DEMOTE_HOT_SCORE=0.40
DEMOTE_WARM_SCORE=0.05
TIME_DECAY_ALPHA=0.3
HEAT_SCORE_INIT=1.0
SCORE_GRACE_MS=1500
MIGRATE_INTERVAL_MS=300
MIGRATE_BATCH_LIMIT=16
