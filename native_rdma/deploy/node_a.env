# --- Node A (example) -------------------------------------------------
# Replace placeholders before running.
SELF_IP=<NODE_A_IP>
PEER_IP=<NODE_B_IP>
RDMA_DEV=<RDMA_DEV>
GID_IDX=<GID_IDX>
DATA_PORT=<DATA_PORT>

UDS_PATH=/tmp/native_rdma-dp.sock
METRICS_SHM=/tmp/native_rdma-metrics.shm

# Control plane
CTRL_PORT=<CTRL_PORT>
WEB_PORT=<WEB_PORT>

# Data directories (ensure they exist and have enough space)
DRAM_CAP_BYTES=68719476736       # 64 GB
NVME_PATH=/dev/shm/native_rdma_warm
NVME_CAP_BYTES=1073741824000     # ~1 TB
HDD_PATH=/home/<USER>/nr_cold
HDD_CAP_BYTES=10995116277760     # 10 TB
