def _rel_path(path: str | Path | None) -> str:
    if not path:
        return ""
    try:
        return str(Path(path).resolve().relative_to(REPO_ROOT))
    except Exception:
        return str(path)


def _dashboard_lines(markdown: str) -> list[str]:
    return str(markdown or "").replace("\r\n", "\n").split("\n")

