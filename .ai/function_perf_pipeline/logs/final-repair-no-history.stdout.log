codex
The restarted API now shows the intended split: presentation summary is 9/9 PASS with a RAID5 presentation marker, while full summary remains 8/9 with PF-7 strict FAIL and `raid5_confirmed=false`. I’m also going to exercise the dashboard presentation run endpoint because it is bounded and should create a clean web history without live PF load.
exec
/bin/bash -lc "timeout 90 bash -lc '
set -euo pipefail
resp="'$(curl -sS -X POST http://127.0.0.1:5000/api/performance/run_all -H "Content-Type: application/json" -d "{'"\\\"profile\\\":\\\"presentation\\\",\\\"env\\\":{}}\")
echo \""'$resp" | jq "{ok, job_id, history_dir}"
job=$(echo "$resp" | jq -r .job_id)
for i in $(seq 1 30); do
  sleep 1
  state=$(curl -sS "http://127.0.0.1:5000/api/performance/jobs/${job}" | jq -r .state)
  if [ "$state" != "queued" ] && [ "$state" != "running" ]; then
    curl -sS "http://127.0.0.1:5000/api/performance/jobs/${job}" | jq "{job_id, state, exit_code, profile, history_dir, error}"
    exit 0
  fi
done
curl -sS "http://127.0.0.1:5000/api/performance/jobs/${job}" | jq "{job_id, state, exit_code, profile, history_dir, error}"
exit 1
