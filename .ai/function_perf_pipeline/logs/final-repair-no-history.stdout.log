        out += ",\"local_gpu_name\":\"";
        append_json_escaped(&out, gi.device_name);
        out += "\",\"local_gpu_base\":";
        out += std::to_string(gi.base_addr);
        out += ",\"local_gpu_len\":";
        out += std::to_string(gi.len);
        out += ",\"local_gpu_lkey\":";
        out += std::to_string(gi.lkey);
        out += ",\"local_gpu_rkey\":";

