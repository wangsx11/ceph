                                peer.slab_base + remote_off,
                                peer.slab_rkey, wr_id);
        bool ok = false;
        if (rc == 0) {
            ok = fut.get();
        } else {
            repl_waiter.cancel_wr_id(wr_id);
        }
        *read_ns = nr::now_ns() - t0;
        return ok;
    };

