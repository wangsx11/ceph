+    def wait_peer_readback(key: str, expected: str) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+        deadline = time.time() + max(0.1, readback_timeout)
+        samples: list[dict[str, Any]] = []
+        last: dict[str, Any] = {}
+        while True:
+            last = ctx.rpc_json("RPC_TCP_GET_PEER", key)
