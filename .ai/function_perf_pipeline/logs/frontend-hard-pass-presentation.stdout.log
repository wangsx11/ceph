(function () {
  function renderResult(detail, job) {
    const raw = detail.raw || {};
    const evidence = Array.isArray(detail.evidence)
      ? detail.evidence
      : (Array.isArray(raw.evidence) ? raw.evidence : []);
    const status = detail.status || raw.presentation_status || raw.status;
