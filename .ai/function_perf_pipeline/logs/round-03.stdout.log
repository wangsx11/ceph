+        ended="$(date +%s)"
+        echo "[ssh-probe] ${ts} ${label}: PASS host=${SSH_PROBE_HOST} elapsed=$(( ended - started ))s output=${out}"
+        return 0
+    fi
+    local rc=$?
+    local ended
+    ended="$(date +%s)"
+    echo "[ssh-probe] ${ts} ${label}: FAIL host=${SSH_PROBE_HOST} rc=${rc} elapsed=$(( ended - started ))s output=${out}"
+    return 1
