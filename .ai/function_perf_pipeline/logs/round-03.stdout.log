+    fi
+    case "${pf}" in
+        PF-1) echo 260 ;;
+        PF-2) echo 90 ;;
+        PF-3) echo 180 ;;
+        PF-4) echo 180 ;;
+        PF-5) echo 140 ;;
+        PF-6) echo 240 ;;
+        PF-7) echo 130 ;;
+        PF-8) echo 180 ;;
+        PF-9) echo 90 ;;
+        *) echo 120 ;;
+    esac
