+        echo "[guard] timeout_s=${timeout_s}"
+        echo "[guard] ssh_probe_host=${SSH_PROBE_HOST}"
+        echo "[guard] command=${cmd[*]}"
+        if ! ssh_probe_once "${label}-pre"; then
