+        -o BatchMode=yes \
+        -o ConnectTimeout="${SSH_PROBE_TIMEOUT_S}" \
+        "${SSH_PROBE_HOST}" hostname 2>&1)"; then
+        local ended
+        ended="$(date +%s)"
+        echo "[ssh-probe] ${ts} ${label}: PASS host=${SSH_PROBE_HOST} elapsed=$(( ended - started ))s output=${out}"
+        return 0
+    fi
+    local rc=$?
+    local ended
+    ended="$(date +%s)"
