+            output = output.decode("utf-8", errors="replace")
+        out.write(
+            f"[ssh-probe] {label}: FAIL host={host} timeout elapsed={elapsed:.1f}s "
+            f"output={str(output).strip()}\n"
+        )
+        out.flush()
+        return False
