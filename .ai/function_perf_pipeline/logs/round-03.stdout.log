+        if [ "${during_failures}" -ge "${SSH_PROBE_FAIL_LIMIT}" ] || [ "${post_rc}" -ne 0 ]; then
+            echo "[guard] SSH probe failure limit reached; stop further high-risk PF execution"
+            exit 90
+        fi
+        exit "${rc}"
+    ) 2>&1 | tee "${log_file}"
+    rc=${PIPESTATUS[0]}
+    return "${rc}"
