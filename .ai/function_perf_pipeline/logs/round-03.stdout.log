+REQUESTED_PFS=("$@")
+if [ "${#REQUESTED_PFS[@]}" -eq 0 ] && [ -n "${PERFORMANCE_PF_LIST:-}" ]; then
+    IFS=', ' read -r -a REQUESTED_PFS <<< "${PERFORMANCE_PF_LIST}"
