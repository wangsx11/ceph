+        echo "[guard] elapsed_s=${elapsed}"
+        echo "[guard] command_rc=${rc}"
+        echo "[guard] ssh_probe_during=${during_total} failures=${during_failures}"
+        echo "[guard] ssh_probe_post_rc=${post_rc}"
