+
+        local during_failures during_total
+        during_failures="$(cat "${fail_file}" 2>/dev/null || echo 0)"
+        during_total="$(cat "${total_file}" 2>/dev/null || echo 0)"
+        rm -rf "${tmp_dir}"
+
+        local post_rc=0
