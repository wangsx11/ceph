+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            timeout=timeout_s + 2,
+        )
+        elapsed = time.time() - started
+        output = (proc.stdout or "").strip()
+        state = "PASS" if proc.returncode == 0 else "FAIL"
+        out.write(
