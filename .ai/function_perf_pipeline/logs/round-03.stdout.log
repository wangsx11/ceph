 PASS=0
 FAIL=0
 RESULTS=()
+SAFETY_ABORT=0
+
+should_run_pf() {
+    local pf="$1"
+    if [ "${#REQUESTED_PFS[@]}" -eq 0 ]; then
+        return 0
+    fi
+    local item
+    for item in "${REQUESTED_PFS[@]}"; do
+        if [ "${item}" = "${pf}" ]; then
+            return 0
+        fi
+    done
