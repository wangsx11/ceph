+        local fail_file="${tmp_dir}/failures"
+        local total_file="${tmp_dir}/total"
+        start_probe_loop "${stop_file}" "${fail_file}" "${total_file}" "${label}" &
+        local probe_pid=$!
+
+        local start_ts end_ts elapsed
+        start_ts="$(date +%s)"
+        timeout --kill-after=10s "${timeout_s}s" "${cmd[@]}"
+        rc=$?
