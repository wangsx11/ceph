+    local total_file="$3"
+    local label="$4"
+    local failures=0
+    local total=0
+    echo 0 > "${fail_file}"
+    echo 0 > "${total_file}"
+    while [ ! -e "${stop_file}" ]; do
+        total=$(( total + 1 ))
+        if ! ssh_probe_once "${label}-during-${total}"; then
+            failures=$(( failures + 1 ))
+        fi
+        echo "${failures}" > "${fail_file}"
+        echo "${total}" > "${total_file}"
