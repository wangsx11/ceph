+        out.write(f"[ssh-probe] {label}: skipped (PERF_SSH_PROBE_HOST empty)\n")
+        out.flush()
+        return True
+    timeout_s = _int_env(env, "PERF_SSH_PROBE_TIMEOUT_S", 5)
+    started = time.time()
