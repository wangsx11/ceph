+    fi
+    case "${pf}" in
+        PF-1) echo 260 ;;
+        PF-2) echo 90 ;;
+        PF-3) echo 180 ;;
+        PF-4) echo 180 ;;
+        PF-5) echo 140 ;;
+        PF-6) echo 240 ;;
+        PF-7) echo 130 ;;
+        PF-8) echo 180 ;;
+        PF-9) echo 90 ;;
+        *) echo 120 ;;
+    esac
+}
+
+ssh_probe_once() {
+    local label="$1"
+    local ts
+    ts="$(date '+%Y-%m-%dT%H:%M:%S%z')"
+    if [ -z "${SSH_PROBE_HOST}" ]; then
+        echo "[ssh-probe] ${ts} ${label}: skipped (PERF_SSH_PROBE_HOST empty)"
+        return 0
+    fi
+    local started
+    started="$(date +%s)"
+    local out
+    if out="$(timeout "$(( SSH_PROBE_TIMEOUT_S + 2 ))s" ssh \
+        -o BatchMode=yes \
+        -o ConnectTimeout="${SSH_PROBE_TIMEOUT_S}" \
+        "${SSH_PROBE_HOST}" hostname 2>&1)"; then
