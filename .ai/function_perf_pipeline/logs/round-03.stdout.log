+def _performance_ssh_probe(env: dict[str, str], label: str, out: Any) -> bool:
+    host = str(env.get("PERF_SSH_PROBE_HOST", "xfusion4")).strip()
+    if not host:
+        out.write(f"[ssh-probe] {label}: skipped (PERF_SSH_PROBE_HOST empty)\n")
