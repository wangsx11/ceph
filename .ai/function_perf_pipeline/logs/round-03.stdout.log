 export NR_ASYNC_REPL=1
 
 NATIVE_ROOT="${REPO_ROOT}/native_rdma"
+PROFILE="${PERFORMANCE_PROFILE:-full}"
+if [ "${1:-}" = "--presentation" ]; then
+    PROFILE="presentation"
