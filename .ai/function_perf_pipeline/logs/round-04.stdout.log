        f"--direct={direct}",
        "--group_reporting",
        "--disk_util=0",
        "--output-format=json",
    ]
    if fsync_enabled:
        cmd.append("--fsync=1")

    proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    run_log.write_text(
