#!/usr/bin/env bash
# demo_down.sh — 停止本端的 Data Plane + Flask
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
SKIP_FLASK="${NR_SKIP_FLASK:-0}"

echo "[demo_down] 精确匹配 native_rdma_dp ..."
