        }
        write_json(raw_json, result)
        run_log.write_text("\n".join(run_lines), encoding="utf-8")
        write_summary(path, result, run_log, raw_json)
        return 2

    keyspace = "1000"

    # Warmup
    for label, batch, count in (
        ("warmup-A", "100", "50"),
        ("warmup-B", "1000", "30"),
    ):
        warmup_cmd = [
