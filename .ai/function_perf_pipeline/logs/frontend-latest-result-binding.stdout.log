  2734	    rows: list[dict[str, Any]] = []
  2735	    aggregate = _read_json(PERFORMANCES_DIR / "raw.json")
  2736	    aggregate_rows = {}
  2737	    if isinstance(aggregate, dict):
  2738	        aggregate_rows = {
  2739	            str(row.get("pf", "")): row
  2740	            for row in aggregate.get("rows", [])
  2741	            if isinstance(row, dict)
  2742	        }
  2743	    for pf_id, _name in _PERFORMANCE_MODULES["performance"]["functions"]:
