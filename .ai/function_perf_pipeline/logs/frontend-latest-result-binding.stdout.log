  2597	    try:
  2598	        tail_bytes = int(request.args.get("tail_bytes", "65536"))
  2599	    except ValueError:
  2600	        tail_bytes = 65536
  2601	    tail_bytes = max(1, min(1024 * 1024, tail_bytes))
  2602	    size = path.stat().st_size
  2603	    with open(path, "rb") as f:
