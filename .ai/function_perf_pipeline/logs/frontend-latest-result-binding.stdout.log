  1871	def _build_performance_summary_payload(profile: str = "full") -> dict[str, Any]:
  1872	    totals = {"total": 0, "PASS": 0, "FAIL": 0, "SKIP": 0, "WAIVED": 0}
  1873	    execution_totals = {"total": 0, "executed": 0, "pending": 0, "PASS": 0, "FAIL": 0, "SKIP": 0, "WAIVED": 0}
  1874	    modules: dict[str, Any] = {}
  1875	    output_rows = []
  1876	    generated_at = ""
  1877	    latest_mtime = 0.0
  1878	    for module, info in _PERFORMANCE_MODULES.items():
  1879	        counts = {"PASS": 0, "FAIL": 0, "SKIP": 0, "WAIVED": 0}
  1880	        execution_counts = {"PASS": 0, "FAIL": 0, "SKIP": 0, "WAIVED": 0}
  1881	        executed_count = 0
  1882	        functions = []
  1883	        for pf_id, name in info["functions"]:
  1884	            if profile == "presentation":
  1885	                raw, history_dir, row_source, row_summary = _presentation_performance_result(pf_id)
  1886	            else:
  1887	                raw, history_dir, row_source, row_summary = _latest_performance_result(pf_id)
  1888	            if profile == "presentation":
  1889	                status = "PASS" if _performance_presentation_passed(pf_id, raw) else _performance_status(raw, pf_id)
  1890	            else:
  1891	                status = _performance_status(raw, pf_id)
  1892	            counts[status] += 1
  1893	            totals[status] += 1
  1894	            totals["total"] += 1
  1895	            execution_totals["total"] += 1
  1896	            launched_from_dashboard = row_source == "前端执行历史"
