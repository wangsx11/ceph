   149	    local timeout_s="$2"
   150	    local log_file="$3"
   151	    shift 3
   152	    local cmd=("$@")
   153	    local rc
   154	
   155	    (
   156	        echo "[guard] label=${label}"
   157	        echo "[guard] timeout_s=${timeout_s}"
   158	        echo "[guard] ssh_probe_host=${SSH_PROBE_HOST}"
   159	        echo "[guard] command=${cmd[*]}"
   160	        if ! ssh_probe_once "${label}-pre"; then
   161	            echo "[guard] pre-run SSH probe failed; refusing to start ${label}"
   162	            exit 90
   163	        fi
   164	
   165	        local tmp_dir
   166	        tmp_dir="$(mktemp -d)"
   167	        local stop_file="${tmp_dir}/stop"
   168	        local fail_file="${tmp_dir}/failures"
   169	        local total_file="${tmp_dir}/total"
   170	        start_probe_loop "${stop_file}" "${fail_file}" "${total_file}" "${label}" &
   171	        local probe_pid=$!
   172	
   173	        local start_ts end_ts elapsed
   174	        start_ts="$(date +%s)"
   175	        timeout --kill-after=10s "${timeout_s}s" "${cmd[@]}"
   176	        rc=$?
   177	        end_ts="$(date +%s)"
   178	        elapsed=$(( end_ts - start_ts ))
   179	
   180	        touch "${stop_file}"
   181	        wait "${probe_pid}" 2>/dev/null || true
   182	
   183	        local during_failures during_total
   184	        during_failures="$(cat "${fail_file}" 2>/dev/null || echo 0)"
   185	        during_total="$(cat "${total_file}" 2>/dev/null || echo 0)"
   186	        rm -rf "${tmp_dir}"
   187	
   188	        local post_rc=0
   189	        ssh_probe_once "${label}-post" || post_rc=$?
   190	        echo "[guard] elapsed_s=${elapsed}"
   191	        echo "[guard] command_rc=${rc}"
   192	        echo "[guard] ssh_probe_during=${during_total} failures=${during_failures}"
   193	        echo "[guard] ssh_probe_post_rc=${post_rc}"
   194	
   195	        if [ "${during_failures}" -ge "${SSH_PROBE_FAIL_LIMIT}" ] || [ "${post_rc}" -ne 0 ]; then
   196	            echo "[guard] SSH probe failure limit reached; stop further high-risk PF execution"
   197	            exit 90
   198	        fi
   199	        exit "${rc}"
   200	    ) 2>&1 | tee "${log_file}"
