  2694	    if not (isinstance(raw, dict) and _performance_presentation_passed(pf_id, raw)):
  2695	        raw, source_dir, _label, summary = _latest_passing_performance_history(pf_id)
  2696	    if not raw:
  2697	        raw, source_dir, _label, summary = _latest_performance_result(pf_id)
  2698	    if not raw:
  2699	        raw = {"metric": pf_id, "passed": False, "error": "no preserved performance evidence"}
  2700	    copied = _annotate_performance_presentation_raw(pf_id, raw)
