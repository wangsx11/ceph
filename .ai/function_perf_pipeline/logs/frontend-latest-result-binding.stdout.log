   108	# ---------- Metrics reader (mmap shared memory) ----------
   109	# Layout matches data_plane/api/metrics_agent.h (must keep in sync).
   110	_METRICS_FMT = "<Q Q Q Q d d d d d Q Q Q d"   # 13 fields
   111	_METRICS_KEYS = [
   112	    "ts_ns", "ops_total", "ops_hi", "ops_lo",
   113	    "bw_tx_gbps", "bw_rx_gbps", "rdma_util_pct",
   114	    "lat_avg_us", "lat_p99_us",
   115	    "obj_dram", "obj_nvme", "obj_hdd",
   116	    "replica_lag_us",
   117	]
   118	_METRICS_SIZE = struct.calcsize(_METRICS_FMT)
   119	
   120	_rate_state = {"last_ts_ns": 0, "last_ops": 0, "ops_per_sec": 0.0}
   121	_rate_lock  = threading.Lock()
   122	
   123	def read_metrics():
   124	    if not os.path.exists(METRICS_SHM):
   125	        return {k: 0 for k in _METRICS_KEYS}
   126	    with open(METRICS_SHM, "rb") as f:
   127	        mm = mmap.mmap(f.fileno(), _METRICS_SIZE, prot=mmap.PROT_READ)
   128	        raw = mm.read(_METRICS_SIZE)
   129	        mm.close()
   130	    if len(raw) != _METRICS_SIZE:
   131	        return {k: 0 for k in _METRICS_KEYS}
   132	    vals = struct.unpack(_METRICS_FMT, raw)
   133	    m = dict(zip(_METRICS_KEYS, vals))
   134	    # Derive instant ops/s from delta of cumulative counter.
   135	    with _rate_lock:
   136	        ts_ns = int(m.get("ts_ns", 0))
   137	        ops   = int(m.get("ops_total", 0))
   138	        last_ts = _rate_state["last_ts_ns"]
   139	        last_op = _rate_state["last_ops"]
   140	        if last_ts > 0 and ts_ns > last_ts:
   141	            dt = (ts_ns - last_ts) / 1e9
   142	            d_ops = max(0, ops - last_op)
   143	            if dt > 0:
   144	                _rate_state["ops_per_sec"] = d_ops / dt
   145	        _rate_state["last_ts_ns"] = ts_ns
   146	        _rate_state["last_ops"]   = ops
   147	        m["ops_per_sec"] = _rate_state["ops_per_sec"]
   148	    return m
