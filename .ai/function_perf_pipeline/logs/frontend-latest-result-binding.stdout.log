  1553	    hist_raw, hist_dir, hist_source, hist_summary = _latest_function_history(module, fn_id)
  1554	    if hist_raw:
  1555	        hist_path = Path(hist_dir) if hist_dir else None
  1556	        candidates.append((
  1557	            _result_sort_key(hist_raw, hist_path),
  1558	            hist_raw,
  1559	            hist_dir,
  1560	            hist_source,
  1561	            hist_summary,
  1562	        ))
  1563	
  1564	    if run_all_row:
  1565	        candidates.append((
  1566	            _result_sort_key(run_all_row, run_all_source_dir),
  1567	            run_all_row,
  1568	            str(run_all_source_dir) if run_all_source_label == "前端执行历史" and run_all_source_dir else "",
  1569	            run_all_source_label or "基线结果",
  1570	            run_all_summary_md,
  1571	        ))
  1572	
  1573	    if not candidates:
  1574	        return {}, "", "基线结果", ""
  1575	
  1576	    # FN-6 has both non-destructive "field present" runs and a full active HA
  1577	    # drill. For the acceptance dashboard, never let a newer field-only run hide
  1578	    # the completed HA drill evidence.
  1579	    if module == "mempool" and fn_id == "FN-6":
  1580	        completed = [
  1581	            item for item in candidates
  1582	            if str(item[1].get("status", "")).upper() == "PASS"
  1583	            and str(item[1].get("completion", "")) == "完成"
  1584	        ]
  1585	        if completed:
  1586	            candidates = completed
  1587	    _key, raw, source_dir, source_label, summary = max(candidates, key=lambda item: item[0])
  1588	    return raw, source_dir, source_label, summary
