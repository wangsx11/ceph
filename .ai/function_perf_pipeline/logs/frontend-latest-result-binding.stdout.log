  1542	
  1543	    baseline_raw = _read_json(fn_dir / "raw.json")
  1544	    if isinstance(baseline_raw, dict) and baseline_raw:
  1545	        candidates.append((
  1546	            _result_sort_key(baseline_raw, fn_dir / "raw.json"),
  1547	            baseline_raw,
  1548	            "",
