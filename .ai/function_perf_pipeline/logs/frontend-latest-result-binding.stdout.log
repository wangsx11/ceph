  2385	                restore_env["NR_TRANSPORT"] = run_env.get("NR_RESTORE_TRANSPORT", "rdma")
  2386	                restore_env["NR_ASYNC_REPL"] = run_env.get("NR_RESTORE_ASYNC_REPL", "0")
  2387	                restore_env["NR_GDR_ENABLE"] = run_env.get("NR_RESTORE_GDR_ENABLE", "0")
  2388	                restore_env["NR_SKIP_FLASK"] = "1"
  2389	                restore_cmd = ["bash", str(REPO_ROOT / "native_rdma" / "start.sh")]
  2390	                with open(stdout_log, "a", encoding="utf-8", errors="replace") as out:
  2391	                    out.write("\n[function-dashboard] restore stack after function\n")
  2392	                    out.flush()
  2393	                    restore_proc = subprocess.run(
  2394	                        restore_cmd,
  2395	                        cwd=str(REPO_ROOT),
  2396	                        env=restore_env,
  2397	                        stdout=out,
  2398	                        stderr=subprocess.STDOUT,
  2399	                        text=True,
  2400	                        timeout=240,
  2401	                    )
  2402	                    out.write(f"\n[function-dashboard] restore exit={restore_proc.returncode}\n")
  2403	                    if restore_proc.returncode != 0:
  2404	                        job["error"] = f"restore stack failed with exit {restore_proc.returncode}"
  2405	            with _FUNCTION_JOB_LOCK:
  2406	                job["state"] = "finished" if rc in (0, 2) else "failed"
  2407	        except Exception as exc:
  2408	            with _FUNCTION_JOB_LOCK:
  2409	                job["state"] = "failed"
  2410	                job["error"] = str(exc)
  2411	            with open(stdout_log, "a", encoding="utf-8", errors="replace") as out:
  2412	                out.write(f"\n[function-dashboard] job failed: {exc}\n")
  2413	        finally:
  2414	            _restore_baseline(saved)
  2415	            with _FUNCTION_JOB_LOCK:
  2416	                job["finished_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
  2417	                _write_job_metadata(job)
