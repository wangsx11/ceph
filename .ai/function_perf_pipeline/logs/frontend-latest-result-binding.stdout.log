  2642	def _prepare_performance_job(kind: str, env: dict[str, str], module: str = "", pf_id: str = "") -> dict[str, Any]:
  2643	    prefix = "pf_all" if kind == "run_all" else f"pf_{pf_id.replace('-', '')}"
  2644	    job_id = _new_job_id(prefix)
  2645	    stamp = time.strftime("%Y%m%d_%H%M%S")
  2646	    if kind == "run_all":
  2647	        history_abs = PERFORMANCES_DIR / "history" / f"web_all_{stamp}_{job_id}"
  2648	    else:
  2649	        history_abs = PERFORMANCES_DIR / pf_id / "history" / f"web_{stamp}_{job_id}"
  2650	    history_abs.mkdir(parents=True, exist_ok=True)
  2651	    job = {
  2652	        "ok": True,
  2653	        "job_id": job_id,
  2654	        "kind": kind,
  2655	        "module": module,
  2656	        "fn_id": pf_id,
  2657	        "state": "queued",
  2658	        "exit_code": None,
  2659	        "started_at": "",
  2660	        "finished_at": None,
  2661	        "error": "",
  2662	        "history_abs": str(history_abs),
  2663	        "history_dir": _rel_path(history_abs),
  2664	        "job_log": _rel_path(history_abs / "stdout.log"),
  2665	        "env": {k: env.get(k, "") for k in _PERFORMANCE_ALLOWED_ENV if k in env},
  2666	        "profile": env.get("PERFORMANCE_PROFILE", "full"),
  2667	        "profile_text": _PERFORMANCE_PROFILE_LABELS.get(env.get("PERFORMANCE_PROFILE", "full"), env.get("PERFORMANCE_PROFILE", "full")),
  2668	    }
  2669	    _PERFORMANCE_JOBS[job_id] = job
  2670	    _write_job_metadata(job)
  2671	    return job
