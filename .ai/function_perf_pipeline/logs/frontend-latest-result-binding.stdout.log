    63	# ---------- UDS client (length-prefixed frames) ----------
    64	# Tracks whether the C++ data plane is currently reachable on UDS.
    65	# Flipped to False on connect/recv error, back to True on successful call.
    66	_dp_online = {"ok": False, "last_err": ""}
    67	_dp_lock = threading.Lock()
    68	
    69	def _set_dp_status(ok: bool, err: str = ""):
    70	    with _dp_lock:
    71	        _dp_online["ok"] = ok
    72	        _dp_online["last_err"] = err
    73	
    74	def is_dp_online() -> bool:
    75	    with _dp_lock:
    76	        return _dp_online["ok"]
