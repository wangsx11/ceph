  2780	            "profile_source": raw.get("profile_source", "live"),
  2781	            "source_mtime": _result_mtime(source_path),
  2782	        })
  2783	    generated_at = time.strftime("%Y-%m-%dT%H:%M:%S%z")
  2784	    raw_all = {
