  2745	        pf_hist = pf_dir / "history" / f"web_all_{_strip_prefix(hist.name, 'web_all_')}"
  2746	        pf_hist.mkdir(parents=True, exist_ok=True)
  2747	        if pf_id in _PERFORMANCE_PRESENTATION_PRESERVE_PFS:
