    78	def uds_call(kind: str, body: bytes = b"") -> bytes:
    79	    try:
    80	        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    81	        s.settimeout(2.0)
    82	        s.connect(UDS_PATH)
    83	        k = kind.encode()
    84	        s.sendall(struct.pack("<I", len(k)) + k +
    85	                  struct.pack("<I", len(body)) + body)
    86	        rl = struct.unpack("<I", s.recv(4))[0]
    87	        data = b""
    88	        while len(data) < rl:
    89	            chunk = s.recv(rl - len(data))
    90	            if not chunk: break
    91	            data += chunk
    92	        s.close()
    93	        _set_dp_status(True)
    94	        return data
    95	    except FileNotFoundError as e:
    96	        _set_dp_status(False, str(e))
    97	        return (b'{"ok":false,"err":"data plane offline (uds socket not found)",'
    98	                b'"dp_offline":true}')
    99	    except (ConnectionRefusedError, ConnectionResetError, BrokenPipeError,
   100	            socket.timeout) as e:
   101	        _set_dp_status(False, str(e))
   102	        return (b'{"ok":false,"err":"data plane offline (' +
   103	                str(e).encode() + b')","dp_offline":true}')
   104	    except Exception as e:
   105	        # Keep DP status unchanged for unknown errors, just surface them.
   106	        return ("{\"ok\":false,\"err\":\"%s\"}" % str(e).replace('"','\\"')).encode()
