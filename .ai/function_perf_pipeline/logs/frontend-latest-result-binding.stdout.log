  2497	    stdout_log = Path(job["history_abs"]) / "stdout.log"
  2498	    stdout_tail = ""
  2499	    if stdout_log.exists():
  2500	        size = stdout_log.stat().st_size
  2501	        with open(stdout_log, "rb") as f:
  2502	            if size > 65536:
  2503	                f.seek(size - 65536)
  2504	            stdout_tail = f.read().decode("utf-8", errors="replace")
  2505	    out = {
  2506	        k: v for k, v in job.items()
  2507	        if k not in {"thread", "process", "history_abs"}
  2508	    }
  2509	    out["stdout_tail"] = stdout_tail
  2510	    return jsonify(out)
