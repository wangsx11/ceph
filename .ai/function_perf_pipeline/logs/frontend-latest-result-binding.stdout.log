  2624	def _apply_performance_run_mode(module: str, pf_id: str, env: dict[str, str]) -> dict[str, str]:
  2625	    run_env = dict(env)
  2626	    run_env.setdefault("NR_SKIP_FLASK", "1")
  2627	    run_env.setdefault("NR_RESTORE_ASYNC_REPL", "0")
  2628	    run_env["NR_TRANSPORT"] = "rdma"
  2629	    run_env["NR_GDR_ENABLE"] = "0"
