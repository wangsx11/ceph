+        sibling = PERFORMANCES_DIR / pf_id / "history" / hist.name
+        try:
+            sibling = sibling.resolve()
+        except Exception:
+            return None
+        if str(sibling).startswith(str(pf_hist_base) + os.sep) and sibling.is_dir():
+            return sibling
+    return None
