  2750	            _copy_if_exists(hist / "preserved" / pf_id / "run_all.last.log", pf_hist / "run_all.last.log")
  2751	            raw = _read_json(pf_hist / "raw.json")
  2752	            source_path = pf_hist
  2753	        else:
  2754	            _copy_if_exists(pf_dir / "summary.md", pf_hist / "summary.md")
  2755	            _copy_if_exists(pf_dir / "raw.json", pf_hist / "raw.json")
  2756	            _copy_if_exists(pf_dir / "run_all.last.log", pf_hist / "run_all.last.log")
  2757	            raw = _read_json(pf_hist / "raw.json")
  2758	            source_path = pf_hist
  2759	            if pf_id in aggregate_rows and isinstance(raw, dict):
  2760	                raw["profile_source"] = aggregate_rows[pf_id].get("profile_source", "live")
  2761	                _atomic_write_json(pf_hist / "raw.json", raw)
