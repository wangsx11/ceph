  2712	    (dst / "run_all.last.log").write_text(
  2713	        "Presentation profile result prepared.\n"
  2714	        f"Source: {copied.get('preserved_source_dir') or 'baseline'}\n",
  2715	        encoding="utf-8",
  2716	    )
  2717	    source_path = Path(source_dir) if source_dir else None
  2718	    return copied, source_path
