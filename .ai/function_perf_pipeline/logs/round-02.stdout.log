    device_ptr_ = nullptr;
    mr_ = {};
    info_ = {};
}

GpuValidateResult GpuDirectBuffer::validate_pattern(
    uint64_t offset, size_t len, uint32_t seed) const {
    GpuValidateResult out{};
    out.offset = offset;
    out.bytes = len;
    out.seed = seed;
    out.error = "NR_USE_CUDA=OFF";
    return out;
}

} // namespace nr

