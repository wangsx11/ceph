+            "NR_ASYNC_REPL": "0",
+            "NR_GDR_ENABLE": "1",
+            "NR_SKIP_FLASK": "1",
+            "NR_RESTART_BEFORE_FUNCTION": "1",
+            "NR_RESTART_STABILIZE_SECONDS": "5",
+            "NR_RESTORE_AFTER_FUNCTION": "1",
+            "NR_RESTORE_TRANSPORT": "rdma",
+            "NR_RESTORE_ASYNC_REPL": "0",
+            "NR_RESTORE_GDR_ENABLE": "0",
+            "NR_RESTORE_WAIT_TIMEOUT": "45",
+        })
