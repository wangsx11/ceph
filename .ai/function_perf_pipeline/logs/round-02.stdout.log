struct GpuValidateResult {
    bool ok = false;
    uint64_t bytes = 0;
    uint64_t offset = 0;
    uint32_t seed = 0;
    uint64_t checksum = 0;
    uint64_t mismatches = 0;
    uint64_t first_bad = UINT64_MAX;
