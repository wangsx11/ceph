        "read_rx_bytes": r_rx,
        "read_avg_resp_bytes": int(avg_resp),
        "read_hit_ratio": round(hit_ratio, 4),
        "passed": passed,
        "note": note,
        "raw_put": jw,
        "raw_get": jr,
    }

