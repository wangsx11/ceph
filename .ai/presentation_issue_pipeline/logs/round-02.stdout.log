#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
OUT_DIR="${OUT_DIR:-${SCRIPT_DIR}}"
UDS="${UDS:-/tmp/native_rdma-dp.sock}"
CTRL_URL="${CTRL_URL:-http://127.0.0.1:5000}"
REQUIRE_PEER="${REQUIRE_PEER:-1}"
WRITE_DUR="${WRITE_DUR:-1}"
READ_DUR="${READ_DUR:-1}"
PF6_DRAIN_SECONDS="${PF6_DRAIN_SECONDS:-0}"
PF6_STABILIZE_S="${PF6_STABILIZE_S:-0.2}"

export REPO_ROOT OUT_DIR UDS CTRL_URL REQUIRE_PEER WRITE_DUR READ_DUR PF6_DRAIN_SECONDS PF6_STABILIZE_S

echo "[PF-6] output directory: ${OUT_DIR}"
echo "[PF-6] running performance test and updating summary.md"
python3 "${SCRIPT_DIR}/run.py" "$@"
exit $?

