   171	    lines.append(f"| `ops_ok` | {sa.get('ops_ok', 'N/A')} |")
   172	    lines.append(f"| `ops_fail` | {sa.get('ops_fail', 'N/A')} |")
   173	    lines.append(f"| `ops_degraded` | {sa.get('ops_degraded', 'N/A')} |")
   174	    lines.append(f"| `threshold` | <= 200ms |")
