    69	def uds_json(uds: str, kind: str, body: bytes = b"", timeout: float = 2.0) -> dict:
    70	    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    71	    sock.settimeout(timeout)
    72	    try:
    73	        sock.connect(uds)
    74	        k = kind.encode()
    75	        sock.sendall(struct.pack("<I", len(k)) + k + struct.pack("<I", len(body)) + body)
    76	        hdr = sock.recv(4)
    77	        if len(hdr) != 4:
    78	            return {"ok": False, "err": "short response header"}
    79	        size = struct.unpack("<I", hdr)[0]
    80	        data = b""
    81	        while len(data) < size:
    82	            chunk = sock.recv(size - len(data))
    83	            if not chunk:
    84	                break
    85	            data += chunk
    86	        return json.loads(data.decode("utf-8", errors="replace"))
    87	    except Exception as exc:
    88	        return {"ok": False, "err": str(exc)}
    89	    finally:
    90	        sock.close()
