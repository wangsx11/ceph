     1	#!/usr/bin/env python3
     2	from __future__ import annotations
     3	
     4	import json
     5	import os
     6	import shutil
     7	import socket
     8	import struct
     9	import subprocess
    10	import time
    11	from pathlib import Path
    12	
    13	
    14	PF_ID = "PF-7"
    15	PF_NAME = "仿真引擎定期备份存储能力"
    16	SOURCE_NO = 7
    17	THRESHOLD = "3+1 RAID5 系统下 4KB 写入 P999 <= 1ms"
    18	
    19	
    20	def out_dir() -> Path:
    21	    path = Path(os.environ.get("OUT_DIR", Path(__file__).resolve().parent)).resolve()
    22	    path.mkdir(parents=True, exist_ok=True)
