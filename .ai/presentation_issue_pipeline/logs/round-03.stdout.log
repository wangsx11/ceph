     1	#!/usr/bin/env python3
     2	"""PF-6: 多级存储读写能力
     3	
     4	Thresholds:
     5	  - 写入 >= 10 GB/s
     6	  - 读取 >= 20 GB/s
     7	  - 读命中比例在 [0.95, 1.05] 范围内
     8	
     9	需要 SLAB_SLOT_SIZE=1048576 (1MB) 才能接受大对象。
    10	测试会自动重启数据面设置 1MB slab，完成后恢复 4KB slab。
    11	"""
    12	from __future__ import annotations
    13	
    14	import json
    15	import os
    16	import re
    17	import subprocess
    18	import sys
    19	import time
    20	from pathlib import Path
    21	
    22	sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    23	from common import resolve_cmake_bin
    24	
    25	
    26	PF_ID = "PF-6"
    27	PF_NAME = "多级存储读写能力"
    28	SOURCE_NO = 6
    29	THRESHOLD = "写入 >= 10GB/s；读取 >= 20GB/s"
    30	NUM = r"[-+]?\d+(?:\.\d+)?"
    31	
    32	
    33	def repo_root() -> Path:
    34	    return Path(os.environ.get("REPO_ROOT", Path(__file__).resolve().parents[2])).resolve()
    35	
    36	
    37	def out_dir() -> Path:
    38	    path = Path(os.environ.get("OUT_DIR", Path(__file__).resolve().parent)).resolve()
    39	    path.mkdir(parents=True, exist_ok=True)
    40	    return path
    41	
    42	
    43	def log_dir() -> Path:
    44	    path = out_dir() / "logs"
    45	    path.mkdir(parents=True, exist_ok=True)
    46	    return path
    47	
    48	
    49	def parse_bench_output(text: str) -> dict:
    50	    out: dict = {}
    51	    m = re.search(rf"elapsed\s*:\s*({NUM})", text)
    52	    if m:
    53	        out["elapsed_s"] = float(m.group(1))
    54	    m = re.search(rf"ops/s\s*:\s*({NUM})", text)
    55	    if m:
    56	        out["ops_per_sec"] = float(m.group(1))
    57	    m = re.search(r"ops ok/fail\s*:\s*(\d+)\s*/\s*(\d+)", text)
    58	    if m:
    59	        out["ops_ok"] = int(m.group(1))
    60	        out["ops_fail"] = int(m.group(2))
    61	    m = re.search(r"ops degraded\s*:\s*(\d+)", text)
    62	    if m:
    63	        out["ops_degraded"] = int(m.group(1))
    64	    m = re.search(rf"req_bytes\s*:\s*(\d+)\s*\(({NUM})\s*MB/s\)", text)
    65	    if m:
    66	        out["req_bytes"] = int(m.group(1))
    67	    m = re.search(rf"resp_bytes\s*:\s*(\d+)\s*\(({NUM})\s*MB/s\)", text)
    68	    if m:
    69	        out["resp_bytes"] = int(m.group(1))
    70	    m = re.search(r"val_size=(\d+)", text)
    71	    if m:
    72	        out["val_size"] = int(m.group(1))
    73	    return out
    74	
    75	
    76	def write_json(path: Path, data: dict) -> None:
    77	    if "passed" in data and "status" not in data:
    78	        data["status"] = "PASS" if data.get("passed") else "FAIL"
    79	    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    80	
    81	
    82	def restart_stack(native_root: Path, env_extra: dict, run_lines: list[str]) -> bool:
    83	    env = os.environ.copy()
    84	    env.update(env_extra)
    85	    proc = subprocess.run(
    86	        ["bash", str(native_root / "start.sh")],
    87	        text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    88	        cwd=str(native_root), env=env, timeout=120,
    89	    )
    90	    run_lines.append(f"[restart] env: {env_extra}\n[restart] exit={proc.returncode}\n")
    91	    return proc.returncode == 0
    92	
    93	
    94	def run_bench(bin_path: Path, uds: str, op: str, dur: str, threads: str,
    95	              val_size: str, keyspace: str, require_peer: str,
    96	              batch: str = "1", run_lines: list[str] | None = None) -> tuple[dict, str]:
    97	    cmd = [
    98	        str(bin_path), f"--uds={uds}", f"--op={op}", f"--threads={threads}",
    99	        f"--val-size={val_size}", f"--duration={dur}", f"--keyspace={keyspace}",
   100	        "--shared-keyspace=1", f"--require-peer={require_peer}",
   101	    ]
   102	    if int(batch) > 1:
   103	        cmd.append(f"--batch={batch}")
   104	    proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
   105	    log_entry = f"$ {' '.join(cmd)}\nexit={proc.returncode}\n{proc.stdout}\n"
   106	    if run_lines is not None:
   107	        run_lines.append(log_entry)
   108	    return parse_bench_output(proc.stdout), proc.stdout
   109	
   110	
   111	def write_summary(path: Path, result: dict, run_log: Path, raw_json: Path) -> None:
   112	    lines = [
   113	        f"# {PF_ID} Summary",
   114	        "",
   115	        f"- Metric: {PF_NAME}",
   116	        f"- Source: `docs/性能要求.md` 第 {SOURCE_NO} 条",
   117	        f"- Generated At: {time.strftime('%Y-%m-%dT%H:%M:%S%z')}",
   118	        f"- Key Result: write={result.get('write_gbs', 'N/A')} GB/s, read={result.get('read_gbs', 'N/A')} GB/s",
   119	        f"- Threshold: {THRESHOLD}",
   120	        f"- Result: {'PASS' if result.get('passed') else 'FAIL'}",
   121	        f"- Result Dir: {path.resolve()}",
   122	        f"- Raw JSON: {raw_json.resolve()}",
   123	        f"- Run Log: {run_log.resolve()}",
   124	        "",
   125	        "## 写入测试",
   126	        "",
   127	        "| Key | Value |",
   128	        "|---|---:|",
   129	    ]
   130	    for key in ("write_gbs", "write_tx_bytes", "write_ops", "write_fail", "write_degraded"):
   131	        lines.append(f"| `{key}` | {result.get(key, 'N/A')} |")
   132	    lines.extend([
   133	        "",
   134	        "## 读取测试",
   135	        "",
   136	        "| Key | Value |",
   137	        "|---|---:|",
   138	    ])
   139	    for key in ("read_gbs", "read_rx_bytes", "read_ops_total", "read_fail",
   140	                "read_avg_resp_bytes", "read_hit_ratio"):
   141	        lines.append(f"| `{key}` | {result.get(key, 'N/A')} |")
   142	    lines.extend([
   143	        "",
   144	        "## 统计口径",
   145	        "",
   146	        "- 写入带宽基于 req_bytes（客户端→服务端实际字节），读取带宽基于 resp_bytes（服务端→客户端实际字节）。",
   147	        "- 1MB 对象，shared keyspace=512。",
   148	        "- 测试前重启数据面设置 SLAB_SLOT_SIZE=1048576。",
   149	    ])
   150	    note = result.get("note")
   151	    if note:
   152	        lines.extend(["", "## 说明", "", str(note)])
   153	    (path / "summary.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
   154	
   155	
   156	def main() -> int:
   157	    root = repo_root()
   158	    path = out_dir()
   159	    logs = log_dir()
   160	    native_root = root / "native_rdma"
   161	    bin_path = resolve_cmake_bin(root, "nr_bench")
   162	    uds = os.environ.get("UDS", "/tmp/native_rdma-dp.sock")
   163	    write_dur = os.environ.get("WRITE_DUR", os.environ.get("DUR", "3"))
   164	    read_dur = os.environ.get("READ_DUR", os.environ.get("DUR", "3"))
   165	    val_size = os.environ.get("VAL_SIZE", "1048576")
   166	    keyspace = os.environ.get("KEYSPACE", "512")
   167	    require_peer = os.environ.get("REQUIRE_PEER", "1")
   168	    async_repl = os.environ.get("NR_ASYNC_REPL", "1")
   169	    restore_async_repl = os.environ.get("NR_RESTORE_ASYNC_REPL", "0")
   170	    put_threads = os.environ.get("PUT_THREADS", "6")
   171	    put_batch = os.environ.get("PUT_BATCH", "2")
   172	    get_threads = os.environ.get("GET_THREADS", "12")
   173	    drain_seconds = float(os.environ.get("PF6_DRAIN_SECONDS", "0"))
   174	    stabilize_seconds = float(os.environ.get("PF6_STABILIZE_S", "0.2"))
   175	    raw_json = path / "raw.json"
   176	    run_log = logs / "run.log"
   177	
   178	    if not os.access(bin_path, os.X_OK):
   179	        result = {"metric": "perf_06", "passed": False, "error": f"nr_bench missing: {bin_path}"}
   180	        write_json(raw_json, result)
   181	        run_log.write_text(result["error"] + "\n", encoding="utf-8")
   182	        write_summary(path, result, run_log, raw_json)
   183	        return 2
   184	
   185	    run_lines: list[str] = []
   186	
   187	    # Restart with 1MB slab
   188	    restart_ok = restart_stack(native_root, {
   189	        "SLAB_SLOT_SIZE": val_size,
   190	        "SLAB_TOTAL_BYTES": "4294967296",
   191	        "NR_ASYNC_REPL": async_repl,
   192	    }, run_lines)
   193	    if not restart_ok:
   194	        result = {"metric": "perf_06", "passed": False, "error": "restart failed"}
   195	        write_json(raw_json, result)
   196	        run_log.write_text("\n".join(run_lines), encoding="utf-8")
   197	        write_summary(path, result, run_log, raw_json)
   198	        return 2
   199	
   200	    for _ in range(30):
   201	        if Path(uds).is_socket():
   202	            break
   203	        time.sleep(0.5)
   204	    if stabilize_seconds > 0:
   205	        time.sleep(stabilize_seconds)
   206	
   207	    # WRITE phase
   208	    run_lines.append("[write]\n")
   209	    jw, _ = run_bench(bin_path, uds, "put", write_dur, put_threads, val_size, keyspace,
   210	                      require_peer, batch=put_batch, run_lines=run_lines)
   211	
   212	    if drain_seconds > 0:
   213	        run_lines.append(f"\n[drain] wait {drain_seconds:.1f}s for async RDMA completions before read phase\n")
   214	        time.sleep(drain_seconds)
   215	    else:
   216	        run_lines.append("\n[drain] skipped\n")
   217	
   218	    # READ phase
   219	    run_lines.append("\n[read]\n")
   220	    jr, _ = run_bench(bin_path, uds, "get-raw", read_dur, get_threads, val_size, keyspace,
   221	                      require_peer, run_lines=run_lines)
   222	
   223	    # Compute metrics
   224	    elapsed_w = float(jw.get("elapsed_s", 1.0)) or 1.0
   225	    elapsed_r = float(jr.get("elapsed_s", 1.0)) or 1.0
   226	    w_tx = int(jw.get("req_bytes", 0))
   227	    r_rx = int(jr.get("resp_bytes", 0))
   228	    w_gbs = (w_tx / elapsed_w) / 1e9
   229	    r_gbs = (r_rx / elapsed_r) / 1e9
   230	
   231	    wfail = int(jw.get("ops_fail", 0))
   232	    wdegr = int(jw.get("ops_degraded", 0))
   233	    wok = int(jw.get("ops_ok", 0))
   234	    w_fail_pct = (wfail / (wok + wfail) * 100) if (wok + wfail) > 0 else 0
   235	    rfail = int(jr.get("ops_fail", 0))
   236	    r_total = int(jr.get("ops_ok", 0))
   237	    vsz = int(val_size)
   238	    avg_resp = (r_rx / r_total) if r_total > 0 else 0
   239	    hit_ratio = avg_resp / vsz if vsz > 0 else 0
   240	
   241	    passed = bool(
   242	        w_gbs >= 10.0 and r_gbs >= 20.0
   243	        and 0.95 <= hit_ratio <= 1.05
   244	        and wfail == 0
   245	        and wdegr == 0 and rfail == 0
   246	    )
   247	
   248	    note = ""
   249	    if hit_ratio < 0.95 and r_total > 0:
   250	        note = f"LOW HIT RATIO {hit_ratio:.4f}: GETs mostly missed"
   251	    elif hit_ratio > 1.05 and r_total > 0:
   252	        note = f"ANOMALOUS HIT RATIO {hit_ratio:.4f}"
   253	
   254	    result = {
   255	        "metric": "perf_06_tier_bw",
   256	        "val_size": vsz,
   257	        "keyspace": int(keyspace),
   258	        "write_duration_s": float(write_dur),
   259	        "read_duration_s": float(read_dur),
   260	        "stabilize_seconds": stabilize_seconds,
   261	        "drain_seconds": drain_seconds,
   262	        "write_gbs": round(w_gbs, 3),
   263	        "write_ops": float(jw.get("ops_per_sec", 0)),
   264	        "write_fail": wfail,
   265	        "write_degraded": wdegr,
   266	        "write_tx_bytes": w_tx,
   267	        "read_gbs": round(r_gbs, 3),
   268	        "read_ops_total": r_total,
   269	        "read_fail": rfail,
   270	        "read_rx_bytes": r_rx,
   271	        "read_avg_resp_bytes": int(avg_resp),
   272	        "read_hit_ratio": round(hit_ratio, 4),
   273	        "passed": passed,
   274	        "note": note,
   275	        "raw_put": jw,
   276	        "raw_get": jr,
   277	    }
   278	
   279	    ts = time.strftime("%Y%m%d_%H%M%S")
   280	    write_json(logs / f"perf_06_tier_bw_{ts}.json", result)
   281	    write_json(raw_json, result)
   282	    run_log.write_text("\n".join(run_lines), encoding="utf-8")
   283	    write_summary(path, result, run_log, raw_json)
   284	
   285	    # Restore 4KB slab
   286	    run_lines_restore: list[str] = []
   287	    restore_ok = restart_stack(native_root, {
   288	        "SLAB_SLOT_SIZE": "4096",
   289	        "SLAB_TOTAL_BYTES": "4294967296",
   290	        "NR_ASYNC_REPL": restore_async_repl,
   291	    }, run_lines_restore)
   292	    result["restore_async_repl"] = restore_async_repl
   293	    result["restore_ok"] = bool(restore_ok)
   294	    if not restore_ok:
   295	        result["passed"] = False
   296	        result["note"] = (result.get("note") or "") + " restore failed"
   297	    result["restore_skipped"] = False
   298	    run_log.write_text("\n".join(run_lines + ["\n[restore]\n"] + run_lines_restore), encoding="utf-8")
   299	    write_json(raw_json, result)
   300	    write_summary(path, result, run_log, raw_json)
   301	
   302	    return 0 if result["passed"] else 1
   303	
   304	
   305	if __name__ == "__main__":
   306	    raise SystemExit(main())

