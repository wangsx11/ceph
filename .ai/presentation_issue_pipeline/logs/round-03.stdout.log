   177	    lines.extend([
   178	        "",
   179	        "## 场景 B: 100 批次 × 1000 个 1KB 对象",
   180	        "",
   181	        "| Key | Value |",
   182	        "|---|---:|",
   183	    ])
   184	    sb = result.get("scenario_b", {})
   185	    lines.append(f"| `elapsed_ms` | {sb.get('elapsed_ms', 'N/A')} |")
   186	    lines.append(f"| `ops_ok` | {sb.get('ops_ok', 'N/A')} |")
   187	    lines.append(f"| `ops_fail` | {sb.get('ops_fail', 'N/A')} |")
   188	    lines.append(f"| `ops_degraded` | {sb.get('ops_degraded', 'N/A')} |")
   189	    lines.append(f"| `threshold` | <= 100ms |")
   190	    lines.append(f"| `passed` | {result.get('passed_b', 'N/A')} |")
   191	
   192	    lines.extend([
   193	        "",
   194	        "## 统计口径",
