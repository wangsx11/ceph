    93	def wait_cluster_ready(uds: str, timeout_s: float, run_lines: list[str]) -> dict:
    94	    deadline = time.time() + timeout_s
    95	    last: dict = {}
    96	    while time.time() < deadline:
    97	        last = uds_json(uds, "RPC_CLUSTER_STATUS")
    98	        if (
    99	            last.get("ok") is True
   100	            and last.get("peer_alive") is True
   101	            and last.get("tcp_data_ready") is True
   102	            and str(last.get("transport", "")) == "rdma"
   103	        ):
   104	            run_lines.append(f"[cluster-ready] {json.dumps(last, ensure_ascii=False)}\n")
   105	            return last
   106	        time.sleep(0.5)
   107	    run_lines.append(f"[cluster-not-ready] {json.dumps(last, ensure_ascii=False)}\n")
   108	    return last
   109	
   110	
   111	def restart_stack(native_root: Path, env_extra: dict[str, str], run_lines: list[str]) -> bool:
   112	    env = os.environ.copy()
   113	    env.update(env_extra)
   114	    proc = subprocess.run(
   115	        ["bash", str(native_root / "start.sh")],
   116	        text=True,
   117	        stdout=subprocess.PIPE,
   118	        stderr=subprocess.STDOUT,
   119	        cwd=str(native_root),
   120	        env=env,
   121	        timeout=120,
   122	    )
   123	    run_lines.append(f"[restart] env: {env_extra}\n[restart] exit={proc.returncode}\n{proc.stdout[-1200:]}\n")
   124	    return proc.returncode == 0
   125	
   126	
   127	def run_bench(cmd: list[str], label: str, run_lines: list[str]) -> tuple[int, dict]:
   128	    proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
   129	    run_lines.append(f"[{label}] $ {' '.join(cmd)}\nexit={proc.returncode}\n{proc.stdout}\n")
   130	    parsed = parse_bench_output(proc.stdout)
   131	    parsed["exit_code"] = proc.returncode
   132	    return proc.returncode, parsed
   133	
   134	
   135	def valid_trial(trial: dict) -> bool:
   136	    return (
   137	        int(trial.get("exit_code", 1)) == 0
   138	        and int(trial.get("ops_fail", -1)) == 0
   139	        and int(trial.get("ops_degraded", -1)) == 0
   140	        and float(trial.get("elapsed_ms", 1e9)) > 0
   141	    )
   142	
   143	
   144	def best_valid(trials: list[dict]) -> dict:
   145	    valid = [t for t in trials if valid_trial(t)]
   146	    if not valid:
   147	        return trials[-1] if trials else {}
   148	    return min(valid, key=lambda t: float(t.get("elapsed_ms", 1e9) or 1e9))
   149	
