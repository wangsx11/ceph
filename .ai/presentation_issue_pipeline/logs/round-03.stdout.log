   156	    run_log = logs / "run.log"
   157	
   158	    if not os.access(bin_path, os.X_OK):
   159	        return fail_early(path, f"nr_bench missing: {bin_path}")
   160	    if not can_connect_uds(uds):
   161	        return fail_early(path, f"data plane UDS is not connectable: {uds}; this test requires the data plane.")
   162	
   163	    run_lines: list[str] = []
   164	
   165	    # Warmup: stabilize heartbeat + memory pools (not measured)
   166	    warmup_cmd = [
   167	        str(bin_path), f"--uds={uds}", "--op=put", f"--threads={threads}",
   168	        "--val-size=1024", f"--duration={os.environ.get('PF2_WARMUP_DUR', '1')}",
   169	    ]
   170	    if int(max_iops or "0") > 0:
   171	        warmup_cmd.append(f"--max-iops={max_iops}")
   172	    rc_warm, _warm = run_bench(warmup_cmd, "warmup", run_lines)
   173	
   174	    # Measured run: use a short, rate-capped window near the 100,000-object
   175	    # requirement. nr_bench --count only terminates batch-mode calls; PF-2 is a
   176	    # single-object PUT path, so duration+max-iops is the bounded live path.
   177	    measured_iops = int(os.environ.get("PF2_MEASURED_MAX_IOPS", str(target_samples)))
   178	    measured_dur = os.environ.get("PF2_MEASURED_DUR", dur)
   179	    cmd = [
