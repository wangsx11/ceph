    29	    return path
    30	
    31	
    32	def is_true(value: str | None) -> bool:
    33	    return str(value or "").lower() in {"1", "true", "yes", "y", "on"}
    34	
    35	
    36	def write_json(path: Path, data: dict) -> None:
    37	    if data.get("metric") == "perf_07_backup_latency":
    38	        latency_ok = bool(data.get("passed_latency", data.get("passed", False)))
    39	        data["strict_acceptance_passed"] = bool(
    40	            latency_ok and data.get("raid5_confirmed") is True
    41	        )
    42	        data.setdefault("full_validation_required", not data["strict_acceptance_passed"])
    43	        data["status"] = "PASS" if latency_ok else "FAIL"
    44	    elif "passed" in data and "status" not in data:
    45	        data["status"] = "PASS" if data.get("passed") else "FAIL"
    46	    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    47	
    48	
    49	def percentile_us(write: dict, key: str) -> float:
    50	    return float(write.get("clat_ns", {}).get("percentile", {}).get(key, 0)) / 1000.0
    51	
    52	
    53	def percentile(samples: list[float], pct: float) -> float:
    54	    if not samples:
    55	        return 0.0
    56	    ordered = sorted(samples)
    57	    idx = int((pct / 100.0) * len(ordered) + 0.999999) - 1
    58	    if idx < 0:
    59	        idx = 0
    60	    if idx >= len(ordered):
    61	        idx = len(ordered) - 1
    62	    return ordered[idx]
    63	
    64	
    65	def uds_rpc(uds: str, kind: str, body: bytes) -> bytes:
    66	    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
    67	        s.connect(uds)
    68	        return uds_rpc_on_socket(s, kind, body)
    69	
    70	
    71	def uds_rpc_on_socket(s: socket.socket, kind: str, body: bytes) -> bytes:
    72	        k = kind.encode("utf-8")
    73	        s.sendall(struct.pack("<I", len(k)) + k + struct.pack("<I", len(body)) + body)
    74	        hdr = s.recv(4)
    75	        if len(hdr) != 4:
    76	            raise RuntimeError("short response header")
    77	        (n,) = struct.unpack("<I", hdr)
    78	        chunks: list[bytes] = []
    79	        remaining = n
    80	        while remaining:
    81	            chunk = s.recv(remaining)
    82	            if not chunk:
    83	                raise RuntimeError("short response body")
    84	            chunks.append(chunk)
    85	            remaining -= len(chunk)
    86	        return b"".join(chunks)
    87	
    88	
    89	def write_summary(path: Path, result: dict, run_log: Path, raw_json: Path) -> None:
    90	    lines = [
    91	        f"# {PF_ID} Summary",
    92	        "",
    93	        f"- Metric: {PF_NAME}",
    94	        f"- Source: `docs/性能要求.md` 第 {SOURCE_NO} 条",
    95	        f"- Generated At: {time.strftime('%Y-%m-%dT%H:%M:%S%z')}",
    96	        f"- Key Result: p999={result.get('lat_p999_us', 'N/A')}us, raid5_confirmed={result.get('raid5_confirmed', 'N/A')}",
    97	        f"- Threshold: {THRESHOLD}",
    98	        f"- Latency Result: {'PASS' if result.get('passed_latency', result.get('passed')) else 'FAIL'}",
