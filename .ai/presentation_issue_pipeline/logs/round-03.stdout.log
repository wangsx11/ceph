   181	        "--val-size=1024", f"--duration={measured_dur}", f"--max-iops={measured_iops}",
   182	        f"--require-peer={require_peer}",
   183	    ]
   184	    rc, parsed = run_bench(cmd, "measured-count", run_lines)
   185	
