   186	    # Measured run with batch PUT
   187	    cmd = [
   188	        str(bin_path), f"--uds={uds}", "--op=put", f"--threads={threads}",
   189	        "--val-size=1024", f"--duration={dur}", f"--require-peer={require_peer}",
   190	        f"--batch={batch}",
   191	    ]
   192	    proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
   193	    run_lines.append(f"[measured] $ {' '.join(cmd)}\nexit={proc.returncode}\n{proc.stdout}\n")
   194	    parsed = parse_bench_output(proc.stdout)
   195	
   196	    ops = float(parsed.get("ops_per_sec", 0))
   197	    size = int(parsed.get("val_size", 1024))
   198	    fail_count = int(parsed.get("ops_fail", 0))
   199	    degraded = int(parsed.get("ops_degraded", 0))
   200	    ops_ok = int(parsed.get("ops_ok", 0))
   201	    total = ops_ok + fail_count
   202	    fail_pct = (fail_count / total * 100.0) if total > 0 else 0.0
   203	    mbps = ops * size / 1e6
   204	
   205	    result = {
   206	        "metric": "perf_05_batch_bw",
   207	        "ops_per_sec": ops,
   208	        "ops_fail": fail_count,
   209	        "ops_degraded": degraded,
   210	        "val_size": size,
   211	        "mb_per_sec": round(mbps, 2),
   212	        "threshold_mbs": 700.0,
   213	        "passed": bool(mbps >= 700.0 and fail_pct < 10.0 and degraded == 0),
   214	        "did_restart": did_restart,
   215	        "raw": parsed,
   216	    }
   217	    if proc.returncode != 0:
   218	        result["note"] = f"nr_bench exited with {proc.returncode}"
   219	
   220	    restore_lines: list[str] = []
   221	    restore_ok = True
   222	    restore_requested = did_restart and str(os.environ.get("PF5_RESTORE", "1")).lower() not in {"0", "false", "no", "off"}
   223	    if restore_requested:
   224	        restore_ok = restart_stack(native_root, {
   225	            "SLAB_SLOT_SIZE": "4096",
   226	            "SLAB_TOTAL_BYTES": "4294967296",
   227	            "NR_ASYNC_REPL": restore_async_repl,
   228	        }, restore_lines)
   229	        run_lines.append("\n[restore functional data-plane defaults]\n")
   230	        run_lines.extend(restore_lines)
   231	    else:
   232	        run_lines.append("\n[restore] skipped (no PF-5 restart)\n")
   233	    result["restore_async_repl"] = restore_async_repl
   234	    result["restore_ok"] = bool(restore_ok)
   235	    result["restore_skipped"] = not restore_requested
   236	    if not restore_ok:
   237	        result["passed"] = False
   238	        result["note"] = (str(result.get("note") or "") + " restore failed").strip()
   239	
   240	    ts = time.strftime("%Y%m%d_%H%M%S")
   241	    write_json(logs / f"perf_05_batch_bw_{ts}.json", result)
   242	    write_json(raw_json, result)
   243	    run_log.write_text("\n".join(run_lines), encoding="utf-8")
   244	    write_summary(path, result, run_log, raw_json)
   245	    return 0 if result["passed"] else 1
   246	
   247	
   248	if __name__ == "__main__":
   249	    raise SystemExit(main())

