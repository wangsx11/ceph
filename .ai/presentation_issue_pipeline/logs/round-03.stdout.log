   134	    logs = log_dir()
   135	    native_root = root / "native_rdma"
   136	    bin_path = resolve_cmake_bin(root, "nr_bench")
   137	    uds = os.environ.get("UDS", "/tmp/native_rdma-dp.sock")
   138	    dur = os.environ.get("DUR", "2")
   139	    threads = os.environ.get("THREADS", "4")
   140	    batch = os.environ.get("BATCH", "64")
   141	    require_peer = os.environ.get("REQUIRE_PEER", "1")
   142	    async_repl = os.environ.get("NR_ASYNC_REPL", "1")
   143	    restore_async_repl = os.environ.get("NR_RESTORE_ASYNC_REPL", "0")
   144	    restart_requested = str(os.environ.get("PF5_RESTART", "0")).lower() in {"1", "true", "yes", "on"}
   145	    raw_json = path / "raw.json"
   146	    run_log = logs / "run.log"
   147	
   148	    if not os.access(bin_path, os.X_OK):
   149	        return fail_early(path, f"nr_bench missing: {bin_path}")
   150	
   151	    run_lines: list[str] = []
