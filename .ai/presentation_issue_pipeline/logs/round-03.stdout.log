    43	def parse_bench_output(text: str) -> dict:
    44	    out: dict = {}
    45	    m = re.search(rf"ops/s\s*:\s*({NUM})", text)
    46	    if m:
    47	        out["ops_per_sec"] = float(m.group(1))
    48	    m = re.search(r"ops ok/fail\s*:\s*(\d+)\s*/\s*(\d+)", text)
    49	    if m:
    50	        out["ops_ok"] = int(m.group(1))
    51	        out["ops_fail"] = int(m.group(2))
    52	    m = re.search(r"ops degraded\s*:\s*(\d+)", text)
    53	    if m:
    54	        out["ops_degraded"] = int(m.group(1))
    55	    m = re.search(r"val_size=(\d+)", text)
    56	    if m:
    57	        out["val_size"] = int(m.group(1))
    58	    return out
