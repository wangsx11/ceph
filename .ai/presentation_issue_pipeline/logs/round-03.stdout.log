"""
native_rdma control plane (Flask).
Non hot-path: cluster control, demo orchestration, metrics aggregation.
Hot-path is handled by the C++ data plane via UDS.
"""
from __future__ import annotations
import os
import re
import struct
import mmap
import json
import shutil
import subprocess
