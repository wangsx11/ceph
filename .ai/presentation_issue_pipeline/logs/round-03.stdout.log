   210	def main() -> int:
   211	    root = repo_root()
   212	    path = out_dir()
   213	    logs = log_dir()
   214	    native_root = root / "native_rdma"
   215	    bin_path = resolve_cmake_bin(root, "nr_bench")
   216	    uds = os.environ.get("UDS", "/tmp/native_rdma-dp.sock")
   217	    require_peer = os.environ.get("REQUIRE_PEER", "1")
   218	    async_repl = os.environ.get("NR_ASYNC_REPL", "0")
   219	    restore_async_repl = os.environ.get("NR_RESTORE_ASYNC_REPL", "0")
   220	    measured_runs = max(1, int(os.environ.get("MEASURED_RUNS", "1")))
   221	    restart_requested = str(os.environ.get("PF4_RESTART", "0")).lower() in {"1", "true", "yes", "on"}
   222	    raw_json = path / "raw.json"
   223	    run_log = logs / "run.log"
   224	    run_lines: list[str] = []
   225	
   226	    if not os.access(bin_path, os.X_OK):
   227	        result = {"metric": "perf_04", "passed": False, "error": f"nr_bench missing: {bin_path}"}
   228	        write_json(raw_json, result)
   229	        run_log.write_text(result["error"] + "\n", encoding="utf-8")
   230	        write_summary(path, result, run_log, raw_json)
   231	        return 2
   232	
   233	    did_restart = False
   234	    if restart_requested or not can_connect_uds(uds):
   235	        restart_ok = restart_stack(native_root, {
   236	            "SLAB_SLOT_SIZE": "4096",
   237	            "SLAB_TOTAL_BYTES": "4294967296",
   238	            "NR_ASYNC_REPL": async_repl,
   239	            "NR_TRANSPORT": "rdma",
   240	            "NR_GDR_ENABLE": "0",
   241	            "NR_SKIP_FLASK": "1",
   242	        }, run_lines)
   243	        did_restart = restart_ok
   244	        if not restart_ok:
   245	            result = {"metric": "perf_04", "passed": False, "error": "restart failed before PF-4"}
   246	            write_json(raw_json, result)
   247	            run_log.write_text("\n".join(run_lines), encoding="utf-8")
   248	            write_summary(path, result, run_log, raw_json)
   249	            return 2
   250	        for _ in range(20):
   251	            if can_connect_uds(uds):
   252	                break
   253	            time.sleep(0.25)
   254	    else:
   255	        run_lines.append("[reuse] existing data plane UDS is connectable; restart skipped\n")
   256	    cluster = wait_cluster_ready(uds, float(os.environ.get("PF4_READY_TIMEOUT_S", "8")), run_lines)
   257	    if not (cluster.get("ok") is True and cluster.get("peer_alive") is True):
   258	        result = {
   259	            "metric": "perf_04",
   260	            "passed": False,
   261	            "error": "peer not ready before PF-4 batch test",
   262	            "cluster": cluster,
   263	        }
   264	        write_json(raw_json, result)
   265	        run_log.write_text("\n".join(run_lines), encoding="utf-8")
   266	        write_summary(path, result, run_log, raw_json)
   267	        return 2
   268	
   269	    keyspace = "1000"
   270	
   271	    # Optional short warmup. The acceptance semantics are in the measured
   272	    # exact-count scenarios below; defaulting warmup to zero keeps UI runs fast.
   273	    for label, batch, count in (
   274	        ("warmup-A", "100", os.environ.get("PF4_WARMUP_A_COUNT", "0")),
   275	        ("warmup-B", "1000", os.environ.get("PF4_WARMUP_B_COUNT", "0")),
   276	    ):
   277	        if int(count) <= 0:
   278	            continue
   279	        warmup_cmd = [
   280	            str(bin_path), f"--uds={uds}", "--op=put",
   281	            f"--batch={batch}", f"--count={count}", "--val-size=1024",
   282	            f"--keyspace={keyspace}", f"--require-peer={require_peer}",
   283	        ]
   284	        run_bench(warmup_cmd, label, run_lines)
   285	
   286	    # Scenario A: 1000 batches × 100 objects
   287	    trials_a: list[dict] = []
   288	    for i in range(measured_runs):
   289	        cmd_a = [
   290	            str(bin_path), f"--uds={uds}", "--op=put",
   291	            "--batch=100", "--count=1000", "--val-size=1024",
   292	            f"--keyspace={keyspace}", f"--require-peer={require_peer}",
   293	        ]
   294	        _rc, trial = run_bench(cmd_a, f"scenario-A-{i + 1}", run_lines)
   295	        trials_a.append(trial)
   296	    sa = best_valid(trials_a)
   297	
   298	    # Scenario B: 100 batches × 1000 objects
   299	    trials_b: list[dict] = []
   300	    for i in range(measured_runs):
   301	        cmd_b = [
   302	            str(bin_path), f"--uds={uds}", "--op=put",
   303	            "--batch=1000", "--count=100", "--val-size=1024",
   304	            f"--keyspace={keyspace}", f"--require-peer={require_peer}",
   305	        ]
   306	        _rc, trial = run_bench(cmd_b, f"scenario-B-{i + 1}", run_lines)
   307	        trials_b.append(trial)
   308	    sb = best_valid(trials_b)
   309	
   310	    ms_a = sa.get("elapsed_ms", 1e9)
   311	    ms_b = sb.get("elapsed_ms", 1e9)
   312	    fail_a = sa.get("ops_fail", -1)
   313	    fail_b = sb.get("ops_fail", -1)
   314	    degr_a = sa.get("ops_degraded", -1)
   315	    degr_b = sb.get("ops_degraded", -1)
   316	    passed_a = ms_a <= 200.0 and fail_a == 0 and degr_a == 0 and valid_trial(sa)
   317	    passed_b = ms_b <= 100.0 and fail_b == 0 and degr_b == 0 and valid_trial(sb)
   318	
   319	    result = {
   320	        "metric": "perf_04_batch_latency",
   321	        "scenario_a": sa,
   322	        "scenario_b": sb,
   323	        "scenario_a_trials": trials_a,
   324	        "scenario_b_trials": trials_b,
   325	        "measured_runs": measured_runs,
   326	        "cluster": cluster,
   327	        "async_repl": async_repl,
   328	        "require_peer": require_peer,
   329	        "did_restart": did_restart,
   330	        "passed_a": bool(passed_a),
   331	        "passed_b": bool(passed_b),
   332	        "passed": bool(passed_a and passed_b),
   333	    }
   334	
   335	    restore_lines: list[str] = []
   336	    restore_ok = True
   337	    restore_requested = did_restart and str(os.environ.get("PF4_RESTORE", "1")).lower() not in {"0", "false", "no", "off"}
   338	    if restore_requested:
   339	        restore_ok = restart_stack(native_root, {
   340	            "SLAB_SLOT_SIZE": "4096",
   341	            "SLAB_TOTAL_BYTES": "4294967296",
   342	            "NR_ASYNC_REPL": restore_async_repl,
   343	            "NR_TRANSPORT": "rdma",
   344	            "NR_GDR_ENABLE": "0",
   345	            "NR_SKIP_FLASK": "1",
   346	        }, restore_lines)
   347	        run_lines.append("\n[restore functional data-plane defaults]\n")
   348	        run_lines.extend(restore_lines)
   349	    else:
   350	        run_lines.append("\n[restore] skipped (no PF-4 restart)\n")
   351	    result["restore_async_repl"] = restore_async_repl
   352	    result["restore_ok"] = bool(restore_ok)
   353	    result["restore_skipped"] = not restore_requested
   354	    if not restore_ok:
   355	        result["passed"] = False
   356	        result["note"] = "restore failed"
   357	
   358	    ts = time.strftime("%Y%m%d_%H%M%S")
   359	    write_json(logs / f"perf_04_batch_latency_{ts}.json", result)
   360	    write_json(raw_json, result)
   361	    run_log.write_text("\n".join(run_lines), encoding="utf-8")
   362	    write_summary(path, result, run_log, raw_json)
   363	    return 0 if result["passed"] else 1
   364	
   365	
   366	if __name__ == "__main__":
   367	    raise SystemExit(main())

