import json, sys, time
from urllib.request import urlopen, Request
base='"'http://192.168.0.218:5000'

def req(path, method='GET', payload=None, timeout=25):
    data=None; headers={'User-Agent':'round5-demo5'}
    if payload is not None:
        data=json.dumps(payload).encode(); headers['Content-Type']='application/json'
    r=Request(base+path, data=data, headers=headers, method=method)
    with urlopen(r, timeout=timeout) as resp:
        return json.loads(resp.read().decode('utf-8','replace'))

def require_cluster():
    j=req('/api/cluster/status')
    ok = j.get('ok') and j.get('peer_alive') and j.get('rdma_connected') and j.get('transport') == 'rdma' and j.get('tcp_data_ready')
    print('cluster', json.dumps({k:j.get(k) for k in ['ok','peer_alive','rdma_connected','transport','tcp_data_ready','peer_num_qp']}, ensure_ascii=False))
    if not ok:
        print('bad cluster', json.dumps(j, ensure_ascii=False, indent=2)); sys.exit(1)

require_cluster()
print('reset', json.dumps(req('/api/demo5/reset', method='POST', payload={}), ensure_ascii=False))
results={}
for rid in [1,2,3]:
    start=req('/api/demo5/start', method='POST', payload={'round': rid})
    print('start_round', rid, json.dumps(start, ensure_ascii=False))
    if not start.get('ok'):
        print('round start failed', rid, json.dumps(start, ensure_ascii=False, indent=2)); sys.exit(2)
    deadline=time.time()+90
    last=None
    while time.time() < deadline:
        snap=req('/api/demo5/snapshot')
        rr=(snap.get('rounds') or {}).get(str(rid)) or (snap.get('rounds') or {}).get(rid) or {}
        last=rr
        print('round_poll', rid, json.dumps({'running': rr.get('running'), 'phase': rr.get('phase'), 'samples': len(rr.get('samples') or []), 'summary': rr.get('summary')}, ensure_ascii=False)[:1400])
        if rr.get('summary') and not rr.get('running'):
            break
        time.sleep(2)
    else:
        print('round timeout', rid, json.dumps(last, ensure_ascii=False, indent=2)); sys.exit(3)
    summary=last.get('summary') or {}
    if not summary.get('passed'):
        print('round failed', rid, json.dumps(summary, ensure_ascii=False, indent=2)); sys.exit(4)
    if summary.get('ops_fail', 0) "'!= 0 or summary.get('"'ops_degraded', 0) "'!= 0:
        print('"'round degraded/fail ops', rid, json.dumps(summary, ensure_ascii=False, indent=2)); sys.exit(5)
    if not (last.get('samples') and len(last.get('samples')) >= 5):
        print('insufficient live samples', rid, len(last.get('samples') or [])); sys.exit(6)
    results[rid]=summary
    require_cluster()
print('PASS demo5 rounds', json.dumps(results, ensure_ascii=False, indent=2))
