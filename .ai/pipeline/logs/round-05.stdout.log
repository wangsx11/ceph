native_rdma/scripts/stop_node.sh:3:# Without cleanup, the metrics shm file keeps the last snapshot on disk and
native_rdma/scripts/stop_node.sh:5:# after a crash/kill. So we unlink both here.
native_rdma/scripts/stop_node.sh:8:# silently leave a zombie DP running (observed during W5: stop_node reported
native_rdma/scripts/stop_node.sh:14:# via `ssh host "pkill -f native_rdma_dp"`, the remote login shell's own
native_rdma/scripts/stop_node.sh:15:# command line contains the literal string "native_rdma_dp" and pkill would
native_rdma/scripts/stop_node.sh:16:# happily kill itself, severing the session before it actually gets to the
native_rdma/scripts/stop_node.sh:20:pkill -TERM -f "$MATCH" 2>/dev/null || true
native_rdma/scripts/stop_node.sh:25:pkill -KILL -f "$MATCH" 2>/dev/null || true
