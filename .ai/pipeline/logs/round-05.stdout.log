    last=req('/api/demo6/status')
    print('poll', json.dumps({'running': last.get('running'), 'busy': last.get('busy'), 'done': last.get('done'), 'step': last.get('step'), 'tiers': last.get('tiers'), 'events': len(last.get('events') or []), 'snapshots': len(last.get('snapshots') or [])}, ensure_ascii=False))
    if last.get('done'):
        break
    time.sleep(2)
else:
