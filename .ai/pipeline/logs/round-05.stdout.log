kind_set={e.get('kind') for e in events}
required_kinds={'BATCH_PUT','HOT_ACCESS','WARM_ACCESS','MIGRATE','SNAP_TRIGGER','SNAPSHOT','REVISIT_COLD'}
missing=required_kinds-kind_set
if missing:
    print('missing event kinds', missing, 'have', sorted(kind_set)); sys.exit(7)
snap_events=[e for e in events if e.get('snap_name') or e.get('kind') in ('SNAP_TRIGGER','SNAPSHOT')]
if not snap_events:
