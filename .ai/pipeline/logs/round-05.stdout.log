/bin/bash -lc 'ts=$(date +%Y%m%d_%H%M%S); log=.ai/pipeline/logs/round5_demo3_${ts}.log; python3 - <<'"'PY' 2>&1 | tee \""'$log"
import json, sys, time, urllib.parse
from urllib.request import urlopen, Request
base='"'http://192.168.0.218:5000'

def req(path, method='GET', payload=None, timeout=20):
    data=None; headers={'User-Agent':'round5-demo3'}
    if payload is not None:
        data=json.dumps(payload).encode(); headers['Content-Type']='application/json'
    r=Request(base+path, data=data, headers=headers, method=method)
    with urlopen(r, timeout=timeout) as resp:
        body=resp.read().decode('utf-8','replace')
        try: j=json.loads(body)
        except Exception: j={'raw':body}
        print(method, path, resp.status, json.dumps(j, ensure_ascii=False)[:1000])
        return j

def assert_ok(label, j):
    if not j.get('ok'):
        print(label, 'FAILED', json.dumps(j, ensure_ascii=False, indent=2))
        sys.exit(1)

cluster_a=req('/api/demo3/cluster')
cluster_b=req('/api/peer/demo3/cluster')
for label,j in [('cluster_a',cluster_a),('cluster_b',cluster_b)]:
    if not (j.get('ok') and j.get('dp_online')):
        print(label, 'bad cluster'); sys.exit(2)
# A must report real RDMA peer health; B proxy reports its own local view.
if not (cluster_a.get('peer_alive') and cluster_a.get('rdma_connected') and cluster_a.get('transport') == 'rdma'):
    print('A not RDMA connected', json.dumps(cluster_a, ensure_ascii=False, indent=2)); sys.exit(3)
for p in ['/api/demo3/flush','/api/peer/demo3/flush']:
    assert_ok('flush '+p, req(p, method='POST', payload={}))
name='round5_demo3_object'
a_data='round5-data-a-' + str(int(time.time()))
b_data='round5-data-b-' + str(int(time.time()))
w=req('/api/demo3/write', method='POST', payload={'name':name,'data':a_data})
assert_ok('write A', w)
if w.get('degraded'):
    print('write was degraded, not acceptable'); sys.exit(4)
# Give metadata announce/peer view a brief moment.
time.sleep(0.2)
q=urllib.parse.quote(name)
rb=req('/api/peer/demo3/read?name='+q)
assert_ok('read B', rb)
if rb.get('data') "'!= a_data:
    print('"'B read mismatch', rb.get('data'), a_data); sys.exit(5)
mb=req('/api/peer/demo3/modify', method='POST', payload={'name':name,'data':b_data})
assert_ok('modify B', mb)
time.sleep(0.2)
ra=req('/api/demo3/read?name='+q)
assert_ok('read A', ra)
if ra.get('data') "'!= b_data:
    print('"'A read mismatch after B modify', ra.get('data'), b_data); sys.exit(6)
objs_a=req('/api/demo3/objects')
objs_b=req('/api/peer/demo3/objects')
if not any(o.get('name') == name for o in objs_a.get('objects', [])):
    print('object missing from A view'); sys.exit(7)
if not any(o.get('name') == name for o in objs_b.get('objects', [])):
    print('object missing from B view'); sys.exit(8)
# best-effort cleanup; not part of pass condition beyond request completion
req('/api/demo3/delete', method='POST', payload={'name':name})
req('/api/peer/demo3/delete', method='POST', payload={'name':name})
print('PASS demo3 two-node write/read/modify/read', json.dumps({'write_latency_us': w.get('latency_us'), 'read_b_hit': rb.get('hit'), 'read_a_hit': ra.get('hit'), 'repl_ns': w.get('repl_ns')}, ensure_ascii=False))
