import json, subprocess, sys, time, urllib.request, urllib.parse
from pathlib import Path
log=Path(sys.argv[1])
base='"'http://127.0.0.1:5000'
def w(s=''):
    with log.open('a', encoding='utf-8') as f:
        f.write(s+'\\n')
def ssh_probe(label):
    w(f'\\n[{label}]')
    for host in ['xfusion3','xfusion4']:
        p=subprocess.run(['ssh','-o','BatchMode=yes','-o','ConnectTimeout=5',host,'hostname'], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        w(f'{host} rc={p.returncode} out={p.stdout.strip()}')
        if p.returncode "'!= 0:
            return False
    return True
def req(method,path,obj=None,timeout=20):
    url=base+path
    data=None
    headers={}
    if obj is not None:
        data=json.dumps(obj, ensure_ascii=False).encode()
        headers['"'Content-Type']='application/json'
    r=urllib.request.Request(url, data=data, method=method, headers=headers)
    t=time.time()
    try:
        with urllib.request.urlopen(r, timeout=timeout) as resp:
            body=resp.read().decode('utf-8','replace')
            code=resp.status
    except Exception as e:
        w(f'{method} {path} EXC {type(e).__name__}: {e}')
        return {'ok': False, 'error': str(e), '_exception': type(e).__name__}
    elapsed=time.time()-t
    try:
        parsed=json.loads(body)
    except Exception:
        parsed={'_raw':body[:500]}
    w(f'{method} {path} code={code} elapsed={elapsed:.3f}s body={json.dumps(parsed, ensure_ascii=False)[:1200]}')
    return parsed
w(f'round1 demo api diagnosis started_at={time.strftime(\"%Y-%m-%dT%H:%M:%S%z\")}')
ssh_probe('ssh-before')
# Demo 3 cross-node minimal path
name=f'round1_probe_{int(time.time())}'
w('\\n[demo3]')
cluster=req('GET','/api/demo3/cluster')
peer_cluster=req('GET','/api/peer/demo3/cluster')
write=req('POST','/api/demo3/write',{'name':name,'data':'round1-data-a'})
peer_read=req('GET','/api/peer/demo3/read?name='+urllib.parse.quote(name))
peer_mod=req('POST','/api/peer/demo3/modify',{'name':name,'data':'round1-data-b'})
self_read=req('GET','/api/demo3/read?name='+urllib.parse.quote(name))
req('POST','/api/demo3/delete',{'name':name})
req('POST','/api/peer/demo3/delete',{'name':name})
w(f'demo3_result ok={all(x.get(\"ok\") for x in [cluster,peer_cluster,write,peer_read,peer_mod,self_read])} name={name}')
# Demo 5 round 1
w('\\n[demo5]')
reset=req('POST','/api/demo5/reset',{})
start=req('POST','/api/demo5/start',{'round':1})
deadline=time.time()+80
last={}
while time.time()<deadline:
    snap=req('GET','/api/demo5/snapshot', timeout=10)
    r=(snap.get('rounds') or {}).get('1') or (snap.get('rounds') or {}).get(1) or {}
    last=r
    w(f'demo5_poll running={r.get(\"running\")} phase={r.get(\"phase\")} samples={len(r.get(\"samples\") or [])} summary={json.dumps(r.get(\"summary\"), ensure_ascii=False)[:300]} error={r.get(\"error\")}')
    if r and not r.get('running') and r.get('phase') not in (None,'idle','starting','running'):
        break
    if r and not r.get('running') and r.get('summary') is not None:
        break
    time.sleep(3)
w(f'demo5_result start_ok={start.get(\"ok\")} final_running={last.get(\"running\")} phase={last.get(\"phase\")} summary={json.dumps(last.get(\"summary\"), ensure_ascii=False)[:800]} error={last.get(\"error\")}')
# Demo 6 full one-shot
w('\\n[demo6]')
req('POST','/api/demo6/reset',{})
d6start=req('POST','/api/demo6/start',{})
deadline=time.time()+120
status={}
while time.time()<deadline:
    status=req('GET','/api/demo6/status', timeout=10)
    w(f'demo6_poll running={status.get(\"running\")} busy={status.get(\"busy\")} step={status.get(\"step\")}/{status.get(\"total_steps\")} done={status.get(\"done\")} tiers={status.get(\"tiers\")} error={status.get(\"error\")}')
    if status.get('done') or status.get('error'):
        break
    time.sleep(3)
w(f'demo6_result start_ok={d6start.get(\"ok\")} done={status.get(\"done\")} step={status.get(\"step\")} tiers={status.get(\"tiers\")} error={status.get(\"error\")} events={len(status.get(\"events\") or [])}')
ssh_probe('ssh-after')
w(f'finished_at={time.strftime(\"%Y-%m-%dT%H:%M:%S%z\")}')
print(f'log={log}')
