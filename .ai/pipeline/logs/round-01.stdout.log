    s.sendall(struct.pack('<I',len(k))+k+struct.pack('<I',0)+body)
    hdr=s.recv(4)
    n=struct.unpack('<I',hdr)[0]
    data=b''
    while len(data)<n:
        chunk=s.recv(n-len(data))
        if not chunk: break
        data+=chunk
