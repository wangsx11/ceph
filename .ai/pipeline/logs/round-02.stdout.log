+    errors = [row for row in rows if row.get("error")]
+    if errors:
+        lines.extend(["", "## Notes"])
+        for row in errors:
+            lines.append(f"- {row['pf']}: {row['error']}")
+    (ROOT / "summary.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
+
