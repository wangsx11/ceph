            "test_plan": _dashboard_named_list(test_section, "测试方案"),
            "source_doc": _rel_path(PERFORMANCE_DASHBOARD_COPY_DOC),
        }
        if goal or implementation or item["prerequisites"] or item["test_plan"]:
