_DASH_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))

def _demo3_store_path() -> str:
    state_dir = os.environ.get(
        "NR_DEMO3_STATE_DIR",
        os.environ.get("NR_STATE_DIR",
                       os.path.expanduser("~/.native_rdma/state")))
