          childLines.shift();
          childLines.pop();
          lines.push({
            text: `${"  ".repeat(level + 1)}"${key}": ${opener}`,
            path: childPath,
            value: childValue,
            highlighted: shouldHighlight(childPath, spec)
          });
          lines.push(...childLines);
          lines.push({
            text: `${"  ".repeat(level + 1)}${closer}${last ? "" : ","}`,
            path: childPath,
