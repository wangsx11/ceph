    stamp = time.strftime("%Y%m%d_%H%M%S")
    if kind == "run_all":
        history_abs = PERFORMANCES_DIR / "history" / f"web_all_{stamp}_{job_id}"
    else:
        history_abs = PERFORMANCES_DIR / pf_id / "history" / f"web_{stamp}_{job_id}"
