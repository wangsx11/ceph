+def _recv_exact(sock: socket.socket, size: int) -> bytes:
+    out = b""
+    while len(out) < size:
+        chunk = sock.recv(size - len(out))
+        if not chunk:
+            raise ConnectionError(f"short read: expected {size}, got {len(out)}")
+        out += chunk
+    return out
+
