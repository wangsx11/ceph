+def _restart_stack(env: dict[str, str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ["bash", str(START_SCRIPT)],
+        cwd=str(REPO_ROOT / "native_rdma"),
+        env=env,
+        text=True,
+        stdout=subprocess.PIPE,
