+    restore["NR_ASYNC_REPL"] = env.get("NR_RESTORE_ASYNC_REPL", "0")
+    restore["NR_GDR_ENABLE"] = env.get("NR_RESTORE_GDR_ENABLE", "0")
+    restore["NR_SKIP_FLASK"] = "1"
