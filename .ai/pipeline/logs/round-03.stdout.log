+        raw = _read_json(p / "raw.json")
+        if not (isinstance(raw, dict) and bool(raw.get("passed", False))):
+            continue
+        candidates.append((_result_mtime(p), p))
+    if not candidates:
+        return None
+    return max(candidates, key=lambda item: item[0])[1]
