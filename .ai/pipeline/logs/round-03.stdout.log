+        row = {
+            "pf": pf_id,
+            "exit_code": 0 if bool(raw.get("passed", False)) else 1,
+            "passed": bool(raw.get("passed", False)),
+            "metric": raw.get("metric", pf_id),
+            "key_result": _key_result(pf_id, raw),
+            "summary": str(raw_path.parent / "summary.md"),
