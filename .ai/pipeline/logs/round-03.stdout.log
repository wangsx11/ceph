+        if os.environ.get("PERFORMANCE_PRESERVED_DIR")
+        else None
+    )
+    for pf_id in PF_IDS:
+        if pf_id in PRESENTATION_LIVE_IDS:
+            rows.append(_run_one_pf(pf_id, env))
+            continue
+        if preserved_root:
