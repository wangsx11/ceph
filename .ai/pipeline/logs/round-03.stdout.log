+    default = _PERFORMANCE_DEFAULT_TIMEOUTS["presentation" if profile == "presentation" else kind]
+    raw = env.get("PERFORMANCE_TIMEOUT_S", "")
+    if not raw:
+        return default
+    try:
+        parsed = int(float(raw))
+    except ValueError:
+        return default
+    return max(1, min(parsed, _PERFORMANCE_MAX_TIMEOUT_S))
