+        aggregate_rows = {
+            str(row.get("pf", "")): row
+            for row in aggregate.get("rows", [])
+            if isinstance(row, dict)
+        }
+    for pf_id, _name in _PERFORMANCE_MODULES["performance"]["functions"]:
