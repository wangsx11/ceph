+                out.write(f"\n[performance-dashboard] presentation job failed: {exc}\n")
+        finally:
+            _restore_baseline(saved)
+            with _PERFORMANCE_JOB_LOCK:
+                job["finished_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
