.content-area {
  min-width: 0;
  width: 100%;
  padding: 18px 20px 22px;
}

.content-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;
}

h1 { margin: 0; font-size: 20px; letter-spacing: 0; }
p { margin: 0; color: var(--muted); line-height: 1.55; }

.module-nav {
  display: grid;
  gap: 8px;
}

.module-card {
  width: 100%;
  display: grid;
  gap: 6px;
  text-align: left;
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 10px 11px;
  cursor: pointer;
}

.module-card:hover,
.module-card.active {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.module-row-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.module-title {
  min-width: 0;
  font-weight: 700;
  line-height: 1.35;
}

.module-meta {
  color: var(--muted);
  font-size: 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fn-nav {
  min-height: 0;
  overflow: auto;
  display: grid;
  gap: 6px;
}

.fn-btn {
  width: 100%;
  min-height: 38px;
  display: grid;
  grid-template-columns: 10px minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  color: var(--text);
  padding: 8px 9px;
  cursor: pointer;
}

.fn-btn.active,
.fn-btn:hover {
  border-color: var(--accent);
  background: var(--surface);
}

.fn-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.35;
}

.fn-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: var(--muted-2);
}

.quick-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  padding: 11px 13px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 8px;
}

.quick-main {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.quick-title {
  font-size: 17px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-meta {
  color: var(--muted);
  font-size: 12px;
}

.quick-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 6px;
}

.detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12px;
  align-items: start;
}

.pane {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
}

.pane-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 12px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--line);
}

.pane-title { font-weight: 700; }
.pane-body { padding: 12px; }

.btn {
  border-radius: 7px;
  border: 1px solid var(--line-strong);
  color: var(--text);
  background: var(--surface);
  padding: 7px 12px;
  cursor: pointer;
  min-height: 34px;
}

.btn:hover { border-color: var(--accent); color: #0c5f66; }
.btn:disabled { opacity: .55; cursor: not-allowed; }
.btn.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  font-weight: 700;
}
.btn.secondary { background: transparent; }


