+    requested = str(body.get("profile") or env.get("PERFORMANCE_PROFILE") or "full").strip().lower()
+    if requested in {"demo", "safe", "presentation-safe"}:
+        requested = "presentation"
+    if requested not in {"full", "presentation"}:
