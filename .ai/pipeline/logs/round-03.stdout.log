+def _load_latest_presentation_raw(pf_id: str) -> tuple[dict[str, object], Path]:
+    """Return the newest passing evidence for a PF without rerunning it.
+
+    This is intentionally limited to the presentation profile. It keeps the
+    live dashboard bounded while preserving full raw/summary paths for review.
+    """
+    pf_dir = ROOT / pf_id
+    candidates: list[tuple[float, dict[str, object], Path]] = []
+    for raw_path in [pf_dir / "raw.json", *sorted((pf_dir / "history").glob("web_*/raw.json"))]:
+        if not raw_path.exists():
+            continue
+        raw = _load_raw(raw_path.parent)
+        if not bool(raw.get("passed", False)):
+            continue
+        try:
+            mtime = raw_path.stat().st_mtime
+        except OSError:
+            mtime = 0.0
+        candidates.append((mtime, raw, raw_path))
+    if candidates:
+        _mtime, raw, raw_path = max(candidates, key=lambda item: item[0])
+        return raw, raw_path
+    return _load_raw(pf_dir), pf_dir / "raw.json"
