+    raw, _source_path = _copy_preserved_performance_evidence(pf_id, pf_hist)
+    pf_dir = PERFORMANCES_DIR / pf_id
+    if pf_id in _PERFORMANCE_PRESENTATION_LIVE_PFS:
+        _atomic_write_json(pf_dir / "raw.json", raw)
+        _copy_if_exists(pf_hist / "summary.md", pf_dir / "summary.md")
+        _copy_if_exists(pf_hist / "run_all.last.log", pf_dir / "run_all.last.log")
+
+
+def _copy_performance_presentation_results(job: dict[str, Any]) -> None:
+    hist = Path(job["history_abs"])
+    rows: list[dict[str, Any]] = []
