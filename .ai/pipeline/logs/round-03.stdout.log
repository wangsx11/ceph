+        f"- Passed: {passed_count}/{len(rows)}",
+        f"- Result: {'PASS' if passed_count == len(rows) else 'FAIL'}",
+        "",
+        "| PF | Key Result | Result | Source |",
+        "|---|---|---:|---|",
+    ]
+    for row in rows:
+        lines.append(
+            f"| {row['pf']} | {row['key_result']} | "
+            f"{'PASS' if row.get('passed') else 'FAIL'} | {row.get('profile_source', 'live')} |"
+        )
+    lines.extend([
+        "",
+        "## Profile Note",
