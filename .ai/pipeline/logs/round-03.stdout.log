+def _latest_passing_child(parent: Path, prefixes: str | tuple[str, ...]) -> Path | None:
+    if not parent.exists():
+        return None
+    if isinstance(prefixes, str):
+        prefixes = (prefixes,)
+    candidates: list[tuple[float, Path]] = []
+    for p in parent.iterdir():
