+def _run_one_pf(pf_id: str, env: dict[str, str]) -> dict[str, object]:
+    pf_dir = ROOT / pf_id
+    cmd = ["bash", str(pf_dir / "run.sh")]
+    print(f"==> {pf_id}", flush=True)
+    started = time.time()
+    proc = subprocess.run(
+        cmd,
+        cwd=str(pf_dir),
+        env=env,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    elapsed = time.time() - started
