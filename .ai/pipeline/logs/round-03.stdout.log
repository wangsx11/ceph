+
+
+def _copy_performance_presentation_results(job: dict[str, Any]) -> None:
+    hist = Path(job["history_abs"])
+    rows: list[dict[str, Any]] = []
+    aggregate = _read_json(PERFORMANCES_DIR / "raw.json")
+    aggregate_rows = {}
