        return f"P999 {_perf_fmt(raw.get('lat_p999_us'), 'us')}，RAID5 {_perf_fmt(raw.get('raid5_confirmed'))}"
    if pf_id == "PF-8":
        return f"speedup {_perf_fmt(raw.get('speedup'), 'x')}，events/s {_perf_fmt(raw.get('events_per_sec'))}"
    if pf_id == "PF-9":
        return (
