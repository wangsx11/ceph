+                    if not raw.get("passed"):
+                        rc = 1
+                out.write("\nAll PFs are left to existing evidence in this bounded presentation path.\n")
+            _copy_performance_presentation_results(job)
+            with _PERFORMANCE_JOB_LOCK:
+                job["exit_code"] = rc
+                job["state"] = "finished" if rc == 0 else "failed"
+        except Exception as exc:
+            with _PERFORMANCE_JOB_LOCK:
+                job["state"] = "failed"
+                job["exit_code"] = 1
+                job["error"] = str(exc)
