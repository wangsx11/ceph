+        if pf_id in PRESENTATION_LIVE_IDS:
+            rows.append(_run_one_pf(pf_id, env))
+            continue
+        if preserved_root:
+            raw_path = preserved_root / pf_id / "raw.json"
+            raw = _load_raw(raw_path.parent)
+            if raw.get("error") == "raw.json not generated":
