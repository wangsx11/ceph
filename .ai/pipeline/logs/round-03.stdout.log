+def _latest_passing_child(parent: Path, prefix: str) -> Path | None:
+    if not parent.exists():
+        return None
+    candidates: list[tuple[float, Path]] = []
+    for p in parent.iterdir():
+        if not p.is_dir() or not p.name.startswith(prefix):
+            continue
+        raw = _read_json(p / "raw.json")
+        if not (isinstance(raw, dict) and bool(raw.get("passed", False))):
+            continue
+        candidates.append((_result_mtime(p), p))
+    if not candidates:
+        return None
