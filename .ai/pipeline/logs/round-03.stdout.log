def _latest_function_result(
    module: str,
    fn_id: str,
    run_all_row: dict[str, Any] | None = None,
    run_all_source_dir: Path | None = None,
    run_all_source_label: str = "",
    run_all_summary_md: str = "",
) -> tuple[dict[str, Any], str, str, str]:
