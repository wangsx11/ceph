+    with _PERFORMANCE_RUN_LOCK:
+        if job.get("state") == "failed":
+            return
+        with _PERFORMANCE_JOB_LOCK:
+            job["state"] = "running"
+            job["started_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
+            _write_job_metadata(job)
+        rc = 0
+        try:
