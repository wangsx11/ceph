        return f"A {_perf_fmt(a.get('elapsed_ms'), 'ms')}，B {_perf_fmt(b.get('elapsed_ms'), 'ms')}"
    if pf_id == "PF-5":
        return f"{_perf_fmt(raw.get('mb_per_sec'), ' MB/s')}"
    if pf_id == "PF-6":
        return f"写 {_perf_fmt(raw.get('write_gbs'), ' GB/s')}，读 {_perf_fmt(raw.get('read_gbs'), ' GB/s')}"
